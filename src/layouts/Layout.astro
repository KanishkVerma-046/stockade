---
import '../styles/global.css';
import ConsentScripts from '../components/layout/ConsentScripts.astro';
import CookieConsent from '../components/layout/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
}

const {
  title = 'Free Stock Market Simulator | Stockade',
  description = 'A free stock market simulator. Practice day trading, paper & crypto trading with $100K virtual money. No signup required. Stocks, forex, futures & crypto.',
  ogImage = '/web-app-manifest-512x512.png',
  ogType = 'website',
  canonical,
} = Astro.props;

const siteUrl = 'https://stockademarketsim.com';

// Cloudflare Pages serves the directory form (/about/) and 308-redirects the
// slashless form to it, so a canonical without the trailing slash points at a
// URL that redirects. Normalising here covers all three sources — the pathname
// fallback, the explicit `canonical` props pages pass, and BlogPost's computed
// one — so individual pages do not each have to remember the slash.
const rawCanonical = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const canonicalUrl = rawCanonical.endsWith('/') ? rawCanonical : `${rawCanonical}/`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="indexnow-key" content="e3d888ea66514206832e8e56e27eed7d" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Stockade" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Stockade — Free Stock Market Simulator" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Stockade — Free Stock Market Simulator" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Stockade" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
    <!-- Google Analytics + AdSense, loaded only after cookie consent -->
    <ConsentScripts />
    <!-- Apply saved theme before render to avoid flash -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.add('light');
        }
      } catch {}
    </script>
  </head>
  <body class="bg-[var(--c-bg)] text-[var(--c-text)] min-h-screen">
    <slot />
    <CookieConsent />
  </body>
</html>
