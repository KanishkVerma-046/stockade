---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import TickerTape from '../components/landing/TickerTape.tsx';
import LiveStats from '../components/landing/LiveStats.tsx';
import { HOME_ALTERNATES } from '../i18n/alternates';

// Single source of truth for the FAQ: the visible section below and the
// FAQPage JSON-LD are both generated from this array.
//
// Google only grants FAQ rich results when the schema text matches what a
// visitor can actually see, word for word. These were previously two separate
// hand-written copies and all 11 pairs had drifted apart, which disqualified
// the block. Generating both from one array makes that drift impossible.
const faqs = [
  {
    q: 'Is Stockade completely free?',
    a: 'Yes — 100% free forever. Every feature, every asset class, every tool. No signup, no credit card, no subscription required.',
  },
  {
    q: 'Can students use Stockade as a stock market simulator?',
    a: 'Absolutely. Stockade is one of the best free stock market simulators for students. No installation or account needed, making it perfect for classroom use, university finance courses, and self-directed learning.',
  },
  {
    q: 'Does Stockade support crypto, forex, and futures?',
    a: 'Yes. Stockade covers stocks, cryptocurrency, forex pairs, and futures contracts (NQ, ES, CL, GC) — browse them all on the <a href="/markets/">Markets page</a>.',
  },
  {
    q: 'Is Stockade a paper trading or day trading simulator?',
    a: 'Both. Step through a full session candle-by-candle at your own pace (paper trading) or stream live prices at 800ms ticks (day trading) — all with $100,000 in virtual money.',
  },
  {
    q: 'What is a stock market simulator?',
    a: 'A stock market simulator is a virtual trading platform that replicates real market conditions using fake money, letting you practice buying and selling stocks, crypto, forex, and futures without financial risk. Stockade gives you $100,000 in virtual capital and professional-grade tools — candlestick charts, technical indicators, and multiple order types — right in your browser, no signup required.',
  },
  {
    q: 'What can I do with a stock market simulator?',
    a: 'Practice buying and selling stocks, crypto, forex pairs, and futures contracts; test strategies against simulated price action; <a href="/blog/analyze-trading-performance-metrics/">track your performance</a> with equity curves, win rate, and drawdown metrics; and build the pattern recognition and discipline needed for real markets — all risk-free.',
  },
  {
    q: 'Is the stock market simulator real or fake?',
    a: 'The money is fake — entirely virtual capital, starting at $100,000, so there is zero financial risk. The prices and charts use realistic simulated market data modeled on real brokerage behavior, so the trading mechanics, chart patterns, and order types mirror what you\'d use in an actual platform. The skill-building is genuine even though the money is not.',
  },
  {
    q: 'How does a stock market simulator work?',
    a: 'Stockade generates realistic price data for 29 assets across stocks, crypto, forex, and futures. You place orders through a full order panel — market, limit, stop-loss, take-profit, and OCO bracket orders — and the simulator fills them instantly. Your virtual P&L, equity curve, win rate, and performance metrics are tracked automatically in your browser with no account required.',
  },
  {
    q: 'What are the risks of using a stock market simulator?',
    a: 'The main risk is developing habits that don\'t account for real-market factors like slippage, liquidity constraints, brokerage fees, and the psychological pressure of real money. Stockade is built for skill-building and education, not as a guarantee of live-trading results. When you transition to real markets, start with small position sizes to adjust for the emotional and execution differences.',
  },
  {
    q: 'What are the limitations of the simulator?',
    a: 'Stockade uses simulated price data rather than a live market feed, so exact real-world spreads, slippage, and after-hours gaps are approximated rather than precisely reproduced. It also cannot fully replicate the psychological pressure of risking real capital. Think of it as a training ground that covers all the technical skills while acknowledging that emotional discipline further develops in live markets.',
  },
  {
    q: 'What is the main advantage of a simulator?',
    a: 'Zero financial risk while developing real trading skills. You can test strategies, make mistakes, and build discipline without losing money. Stockade gives you $100,000 in virtual capital and professional tools — candlestick charts, EMA/VWAP/RSI/MACD, a full order panel, and a detailed analytics dashboard — the same environment as a real brokerage, completely free and consequence-free.',
  },
];

// A couple of answers link out to relevant pages (see the `a` values above).
// Google's FAQ rich-result match is on the rendered text, not the markup, so
// the schema strips those tags rather than restating a second plain copy.
const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://stockademarketsim.com/#faq',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(a) },
  })),
};

// Escaping "<" prevents a stray "</script>" inside any string from
// terminating the JSON-LD block early.
const faqSchemaJson = JSON.stringify(faqSchema).replace(/</g, '\\u003c');
---

<Layout
  title="Stockade | Free Stock Market Simulator"
  description="A free stock market simulator with fake money. Practice day & paper trading with $100K virtual funds — stocks, crypto, forex, futures. No signup required."
  alternates={HOME_ALTERNATES}
>
  <Fragment slot="head">
    <!-- The WebSite and Organization entities live in SiteSchema.astro and are
         emitted on every page by the base layout. Only the home-page-specific
         SoftwareApplication node is declared here; it points back at those by @id. -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "SoftwareApplication",
            "@id": "https://stockademarketsim.com/#app",
            "name": "Stockade Stock Market Simulator",
            "url": "https://stockademarketsim.com/",
            "applicationCategory": "FinanceApplication",
            "operatingSystem": "Web Browser",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD"
            },
            "description": "Free online stock market simulator for paper trading stocks, crypto, forex, and futures. No signup required.",
            "screenshot": "https://stockademarketsim.com/web-app-manifest-512x512.png",
            "featureList": [
              "Simulated candlestick charts with volume",
              "EMA, VWAP, RSI, MACD indicators",
              "Market and limit orders with stop-loss / take-profit OCO brackets",
              "Paper trading with $100,000 virtual balance",
              "Analytics dashboard with equity curve",
              "Stocks, crypto, forex, and futures"
            ],
            "publisher": { "@id": "https://stockademarketsim.com/#organization" },
            "isPartOf": { "@id": "https://stockademarketsim.com/#website" }
          }
        ]
      }
    </script>
    {/* Generated from the `faqs` array in the frontmatter, the same source the
        visible FAQ section renders from, so the two cannot drift apart. */}
    <script type="application/ld+json" is:inline set:html={faqSchemaJson} />
  </Fragment>

  <Navbar alternates={HOME_ALTERNATES} />

  <!-- ── Hero ── -->
  <section class="relative overflow-hidden mesh-gradient">
    <!-- Grid overlay -->
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(var(--c-text) 1px, transparent 1px), linear-gradient(90deg, var(--c-text) 1px, transparent 1px); background-size: 40px 40px;"
    ></div>

    <div class="relative max-w-[1100px] mx-auto px-6 pt-24 pb-28 text-center">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--c-amber-bg)] border border-[var(--c-amber-dim)] text-[#f59e0b] text-[12px] font-mono mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-[#22c55e] animate-pulse"></span>
        Free · No Signup · $100K Virtual Balance
      </div>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] mb-6">
        Practice the market.
        <br />
        <span class="gradient-text">Master the game.</span>
      </h1>

      <!-- Subhead -->
      <p class="text-lg sm:text-xl text-[var(--c-text-muted)] max-w-[600px] mx-auto mb-10 leading-relaxed">
        The free stock &amp; crypto trading simulator with realistic simulated market data.
        No signup. No risk. Just virtual trading.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap justify-center gap-3 mb-16">
        <a
          href="/simulator/"
          class="px-6 py-3 rounded-full bg-[#f59e0b] text-[#0a0a0a] font-semibold text-[15px] hover:bg-[#fbbf24] transition-colors"
        >
          Start Trading Free →
        </a>
        <a
          href="/markets/"
          class="px-6 py-3 rounded-full bg-[var(--c-bg-muted)] text-[var(--c-text)] font-semibold text-[15px] border border-[var(--c-border)] hover:bg-[var(--c-surface-2)] transition-colors"
        >
          View Markets
        </a>
      </div>

      <!-- Live stats -->
      <LiveStats client:load />
    </div>
  </section>

  <!-- ── App preview ── -->
  <section class="border-y border-[var(--c-border)] bg-[var(--c-bg-soft)] px-6 py-16">
    <div class="max-w-[1100px] mx-auto">
      <div class="rounded-xl overflow-hidden border border-[var(--c-border)] shadow-2xl">
        <!-- Terminal header -->
        <div class="flex items-center gap-2 px-4 py-3 bg-[var(--c-bg-muted)] border-b border-[var(--c-border)]">
          <span class="w-3 h-3 rounded-full bg-[#ef4444]"></span>
          <span class="w-3 h-3 rounded-full bg-[#f59e0b]"></span>
          <span class="w-3 h-3 rounded-full bg-[#22c55e]"></span>
          <span class="ml-3 text-[12px] font-mono text-[var(--c-text-subtle)]">stockademarketsim.com/simulator — APXL 1M</span>
          <span class="ml-auto text-[10px] font-mono text-[var(--c-text-subtle)] border border-[var(--c-border)] px-2 py-0.5 rounded tracking-wider">SAMPLE PREVIEW</span>
        </div>
        <!-- Chart preview (static SVG) -->
        <div class="bg-[var(--c-bg-subtle)] relative overflow-hidden" style="height: 320px;">
          <svg viewBox="0 0 1200 320" class="w-full h-full" preserveAspectRatio="none">
            <line x1="0" y1="64" x2="1200" y2="64" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="128" x2="1200" y2="128" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="192" x2="1200" y2="192" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="256" x2="1200" y2="256" stroke="var(--c-border)" stroke-width="1"/>
            <defs>
              <linearGradient id="g1" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#22c55e" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="#22c55e" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path d="M0,240 C80,220 160,200 240,195 S400,165 480,150 S640,125 720,118 S900,100 960,95 S1100,80 1200,70"
              stroke="#22c55e" stroke-width="2" fill="none" opacity="0.9"/>
            <path d="M0,240 C80,220 160,200 240,195 S400,165 480,150 S640,125 720,118 S900,100 960,95 S1100,80 1200,70 V320 H0 Z"
              fill="url(#g1)"/>
          </svg>

          <div class="absolute top-4 left-4 rounded-lg px-3 py-2 border border-[var(--c-border)] backdrop-blur-sm" style="background-color: var(--c-overlay);">
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] uppercase tracking-widest mb-0.5">APXL · 1M</div>
            <div class="text-[22px] font-mono font-semibold text-[var(--c-text)]">$187.42</div>
            <div class="text-[13px] font-mono text-[#22c55e]">+1.23 (+0.66%)</div>
          </div>

          <div class="absolute top-4 right-4 w-[160px] rounded-lg border border-[var(--c-border)] p-3" style="background-color: var(--c-overlay);">
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] uppercase tracking-widest mb-2">Order</div>
            <div class="flex gap-1 mb-2">
              <div class="flex-1 py-1.5 bg-[var(--c-green-bg)] border border-[var(--c-green-dim)] text-[#22c55e] text-[11px] font-mono text-center rounded">BUY</div>
              <div class="flex-1 py-1.5 bg-[var(--c-bg-muted)] border border-[var(--c-border)] text-[var(--c-text-subtle)] text-[11px] font-mono text-center rounded">SELL</div>
            </div>
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] mb-1">Equity</div>
            <div class="text-[14px] font-mono font-semibold text-[#22c55e]">$102,340</div>
          </div>

          <div class="absolute bottom-4 left-4 flex gap-2">
            <div class="bg-[var(--c-green-bg)] border border-[var(--c-green-dim)] rounded px-2.5 py-1.5">
              <div class="text-[10px] font-mono text-[var(--c-text-subtle)]">P&amp;L</div>
              <div class="text-[15px] font-mono font-semibold text-[#22c55e]">+$2,340</div>
            </div>
            <div class="bg-[var(--c-amber-bg)] border border-[var(--c-amber-dim)] rounded px-2.5 py-1.5">
              <div class="text-[10px] font-mono text-[var(--c-text-subtle)]">Win Rate</div>
              <div class="text-[15px] font-mono font-semibold text-[#f59e0b]">68%</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features ── -->
  <section class="py-24 px-6 bg-[var(--c-bg)]">
    <div class="max-w-[1100px] mx-auto">
      <div class="text-center mb-14">
        <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-3">Why Stockade</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)]">Everything a serious trader needs.</h2>
        <p class="mt-4 text-[var(--c-text-muted)] text-lg max-w-[480px] mx-auto">
          Built for learning, not gamification. Professional tools without the price tag.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: '📈', title: 'Real Candlestick Charts', desc: 'Full candlestick + volume with EMA, VWAP, RSI, MACD indicators — same tools the pros use.' },
          { icon: '⚡', title: 'Instant Order Fills',     desc: 'Market, limit, stop-loss, take-profit, and OCO bracket orders executed instantly.' },
          { icon: '⌨️', title: 'Keyboard Shortcuts',      desc: 'B to buy, S to sell, F to flatten. Trade at the speed of thought without touching the mouse.' },
          { icon: '📊', title: 'Analytics Dashboard',     desc: 'Win rate, profit factor, avg win/loss, equity curve, drawdown, and time-of-day heatmaps.' },
          { icon: '💼', title: 'Multi-Asset',             desc: 'Equities, crypto, forex pairs, and futures — all in one simulator.' },
          { icon: '📱', title: 'Mobile First',            desc: 'Fully responsive. Trade from phone, tablet, or desktop with the same feature set.' },
          { icon: '🆓', title: '100% Free Forever',       desc: 'Every feature. Every asset. No registration. No trials. No subscriptions. Just start.' },
        ].map(f => (
          <div class="bg-[var(--c-bg-soft)] border border-[var(--c-border)] rounded-xl p-5 hover:border-[var(--c-border-strong)] transition-colors group">
            <div class="text-2xl mb-3">{f.icon}</div>
            <h3 class="text-[15px] font-semibold text-[var(--c-text)] mb-2 group-hover:text-[#f59e0b] transition-colors">{f.title}</h3>
            <p class="text-[13px] text-[var(--c-text-subtle)] leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Asset coverage ── -->
  <section class="py-20 px-6 bg-[var(--c-bg-soft)] border-y border-[var(--c-border)]">
    <div class="max-w-[1100px] mx-auto">
      <div class="text-center mb-12">
        <div class="text-[11px] font-mono uppercase tracking-widest text-[#22c55e] mb-3">Asset Coverage</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)]">Trade everything.</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {[
          { label: 'Stocks',  sub: 'Equities · 14 Tickers',         icon: '📈', color: '#3b82f6' },
          { label: 'Crypto',  sub: 'Tokens &amp; Coins · 8 Assets', icon: '🪙', color: '#f59e0b' },
          { label: 'Forex',   sub: 'EUR/USD · GBP/USD · USD/JPY',   icon: '💱', color: '#22c55e' },
          { label: 'Futures', sub: 'NQ · ES · CL · GC',             icon: '🔮', color: '#8b5cf6' },
        ].map(a => (
          <div class="bg-[var(--c-bg)] border border-[var(--c-border)] rounded-xl p-5 text-center hover:border-[var(--c-border-strong)] transition-colors">
            <div class="text-3xl mb-3">{a.icon}</div>
            <div class="text-[16px] font-semibold mb-1" style={`color: ${a.color}`}>{a.label}</div>
            <div class="text-[12px] font-mono text-[var(--c-text-subtle)]" set:html={a.sub}></div>
          </div>
        ))}
      </div>
      <p class="text-center text-[11px] font-mono text-[var(--c-text-subtle)] mt-6">
        All tickers are fictional simulated assets and do not represent real securities, cryptocurrencies, or tradable instruments.
      </p>
    </div>
  </section>

  <!-- ── SEO Content ── -->
  <section class="py-24 px-6 bg-[var(--c-bg-soft)] border-t border-[var(--c-border)]">
    <div class="max-w-[800px] mx-auto">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-4">About Stockade</div>
      <article class="prose-stockade">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)] mb-6">
          Practice the market without putting money on the line
        </h2>

        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
Stockade is a <a href="/simulator/" class="text-[#f59e0b] hover:underline">stock market simulator</a> you open in a browser tab and start using about ten seconds later. You get <strong class="text-[var(--c-text)]">$100,000 in virtual money</strong> and a full trading environment covering stocks, crypto, forex, and futures. There's no account to create, no card to enter, and nothing to install. Make a terrible trade and the only thing you lose is a number on a screen — that's what practice trading is for.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Why most trading games fall flat
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          A lot of simulators optimize for engagement instead of realism. They strip out the indicators, the order types, and the risk metrics, and what's left is a game about watching a number go up — fun for an afternoon, and it teaches you almost nothing that survives contact with a real brokerage. We went the other way. Stockade gives you candlestick charts with volume histograms, EMA 9/20/50 overlays, VWAP, RSI, and MACD, plus an order panel with market and limit entries and stop-loss / take-profit levels that work as an OCO bracket. The point is that the habits you build here still work when you switch to a real platform — see <a href="/blog/paper-trading-guide/" class="text-[#f59e0b] hover:underline">the paper trading guide</a> for how to make that transfer stick.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Two ways to practice: live and replay
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Live mode streams six assets at once with prices updating every 800 milliseconds, so you can practice day trading against a fast tape and find out how you actually behave under pressure. Replay mode does the opposite — you step through a full session one candle at a time, taking as long as you want on each decision. Most people use live mode to build reflexes and replay to build pattern recognition — for practice focused purely on reading formations rather than P&amp;L, the <a href="/chart-simulator/" class="text-[#f59e0b] hover:underline">Chart Simulator</a> steps through candlestick patterns the same way. Broker-run paper trading simulators usually want registration and a linked real account before they'll let you place a single order. Here, you just open the page.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Stocks, crypto, forex, and futures in one place
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          There are 14 equity tickers with realistic price behavior, 8 crypto assets that move with the volatility you'd expect from the real thing, major and minor currency pairs, and four futures contracts — NQ, ES, CL, and GC. That range matters more than it sounds: a strategy that looks brilliant on a slow-moving equity often falls apart on a currency pair or a futures contract, and having everything on <a href="/markets/" class="text-[#f59e0b] hover:underline">one platform</a> makes that easy to find out.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Review what actually happened
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Placing trades is the easy half; the useful half is picking apart the results afterward. The <a href="/analytics/" class="text-[#f59e0b] hover:underline">analytics dashboard</a> reads your trade history and reports equity curve, win rate, profit factor, average win and loss, maximum drawdown, and a heatmap showing which hours of the day your trades actually worked. Because there's nothing to install and no sign-up wall, that whole loop runs in a browser tab — which also makes it workable for a classroom or study group, where getting everyone through a registration form is usually the hard part.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          No paywalls, no premium tier
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-4">
          Plenty of platforms keep their best tools behind a subscription, or make you hand over an email address before you can place a single trade. Stockade doesn't. Everything here is included, permanently:
        </p>
        <ul class="space-y-2 mb-6 ml-4">
          {[
            'Full candlestick charts with volume',
            'Professional indicators: EMA, VWAP, RSI, MACD',
            'Order panel: market and limit entries, stop-loss / take-profit OCO brackets',
            'Performance analytics with equity curves and drawdown tracking',
            'Complete mobile and tablet support',
          ].map(item => (
            <li class="flex items-start gap-2 text-[15px] text-[var(--c-text-muted)]">
              <span class="text-[#22c55e] mt-0.5 shrink-0">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed">
          No trials, no freemium tier, no upsells, no email capture. Open the simulator and start trading.
        </p>
      </article>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section id="faq" class="py-20 px-6 bg-[var(--c-bg)] border-t border-[var(--c-border)]">
    <div class="max-w-[800px] mx-auto">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-4">FAQ</div>
      <h2 class="text-3xl font-bold tracking-tight text-[var(--c-text)] mb-10">Common questions</h2>
      <div class="space-y-6">
        {faqs.map(({ q, a }) => (
          <div class="border border-[var(--c-border)] rounded-xl p-5 bg-[var(--c-bg-soft)]">
            <h3 class="text-[15px] font-semibold text-[var(--c-text)] mb-2">{q}</h3>
            <p class="text-[14px] text-[var(--c-text-subtle)] leading-relaxed [&_a]:text-[#f59e0b] [&_a]:hover:underline" set:html={a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA band ── -->
  <section class="py-24 px-6 bg-[var(--c-bg-soft)] border-t border-[var(--c-border)] text-center mesh-gradient">
    <div class="max-w-[640px] mx-auto">
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight mb-5 text-[var(--c-text)]">
        Ready to start trading?
      </h2>
      <p class="text-[var(--c-text-muted)] text-lg mb-8">
        No credit card. No signup. $100,000 virtual balance waiting.
      </p>
      <a
        href="/simulator/"
