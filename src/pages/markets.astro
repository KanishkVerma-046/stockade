---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import MarketsView from '../components/markets/MarketsView.tsx';
---

<Layout
  title="Stocks, Crypto, Forex & Futures Markets | Stockade"
  description="Monitor 29 simulated assets including stocks, crypto, forex, and futures on our free online stock market simulator. No signup required."
>
  <Navbar />
  <main class="max-w-[1400px] mx-auto px-4 py-8">
    <div class="mb-8">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-2">Markets</div>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--c-text)]">Market Overview</h1>
      <p class="mt-2 text-[var(--c-text-subtle)] text-[14px]">Market overview refreshes every 2 seconds across 29 simulated assets — stocks, crypto, forex, and futures. Use it as a crypto trading simulator watchlist, a forex simulator scanner, or just a quick check on where prices stand before you trade. For 800ms live ticks, use the <a href="/simulator/" class="text-[#f59e0b] hover:underline">Trading Simulator</a>.</p>
    </div>
    <MarketsView client:load />
  </main>
  <Footer />
</Layout>
