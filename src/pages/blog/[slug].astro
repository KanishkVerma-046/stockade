---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  // Drafts are filtered here rather than only on the index, so no page is
  // generated for them at all. That also keeps them out of the sitemap,
  // which lists built routes.
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const esPosts = await getCollection('blogEs', ({ data }) => !data.draft);
  const ptPosts = await getCollection('blogPt', ({ data }) => !data.draft);
  const jaPosts = await getCollection('blogJa', ({ data }) => !data.draft);
  const frPosts = await getCollection('blogFr', ({ data }) => !data.draft);
  const dePosts = await getCollection('blogDe', ({ data }) => !data.draft);
  const koPosts = await getCollection('blogKo', ({ data }) => !data.draft);
  // Translated posts use localized slugs, so they're matched to the English
  // post they translate via `translationOf` (the English post's id) rather
  // than by sharing an id/filename.
  const esByTranslationOf = new Map(esPosts.map(p => [p.data.translationOf, p]));
  const ptByTranslationOf = new Map(ptPosts.map(p => [p.data.translationOf, p]));
  const jaByTranslationOf = new Map(jaPosts.map(p => [p.data.translationOf, p]));
  const frByTranslationOf = new Map(frPosts.map(p => [p.data.translationOf, p]));
  const deByTranslationOf = new Map(dePosts.map(p => [p.data.translationOf, p]));
  const koByTranslationOf = new Map(koPosts.map(p => [p.data.translationOf, p]));
  // Every article declares a frontmatter `slug`, which the glob loader
  // uses as the entry id — so `post.id` IS the URL segment.
  return posts.map(post => {
    const esPost = esByTranslationOf.get(post.id);
    const ptPost = ptByTranslationOf.get(post.id);
    const jaPost = jaByTranslationOf.get(post.id);
    const frPost = frByTranslationOf.get(post.id);
    const dePost = deByTranslationOf.get(post.id);
    const koPost = koByTranslationOf.get(post.id);
    // Only advertise hreflang alternates once at least one translation
    // actually exists, same as every other page in this project.
    const alternates: Record<string, string> = {};
    if (esPost || ptPost || jaPost || frPost || dePost || koPost) alternates.en = `/blog/${post.id}/`;
    if (esPost) alternates.es = `/es/blog/${esPost.id}/`;
    if (ptPost) alternates.pt = `/pt/blog/${ptPost.id}/`;
    if (jaPost) alternates.ja = `/ja/blog/${jaPost.id}/`;
    if (frPost) alternates.fr = `/fr/blog/${frPost.id}/`;
    if (dePost) alternates.de = `/de/blog/${dePost.id}/`;
    if (koPost) alternates.ko = `/ko/blog/${koPost.id}/`;
    return {
      params: { slug: post.id },
      props: {
        post,
        alternates: Object.keys(alternates).length > 0 ? alternates : undefined,
      },
    };
  });
}

const { post, alternates } = Astro.props;
// Also filtered, so a draft can never surface as a related-post link.
const posts = await getCollection('blog', ({ data }) => !data.draft);
const { Content, headings } = await render(post);
---

<BlogPost post={post} posts={posts} headings={headings} alternates={alternates}>
  <Content />
</BlogPost>
