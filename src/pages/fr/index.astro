---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import TickerTape from '../../components/landing/TickerTape.tsx';
import LiveStats from '../../components/landing/LiveStats.tsx';
import { HOME_ALTERNATES } from '../../i18n/alternates';
import { t } from '../../i18n/ui';

const locale = 'fr' as const;

// Single source of truth for the FAQ: the visible section below and the
// FAQPage JSON-LD are both generated from this array. Mirrors the structure
// of the English src/pages/index.astro — see that file for why the schema is
// generated rather than hand-duplicated.
const faqs = [
  {
    q: 'Stockade est-il entièrement gratuit ?',
    a: 'Oui — 100 % gratuit, pour toujours. Toutes les fonctionnalités, toutes les classes d\'actifs, tous les outils. Sans inscription, sans carte bancaire, sans abonnement requis.',
  },
  {
    q: 'Les étudiants peuvent-ils utiliser Stockade comme simulateur de marché boursier ?',
    a: 'Absolument. Stockade est l\'un des meilleurs simulateurs de marché boursier gratuits pour les étudiants. Aucune installation ni aucun compte n\'est nécessaire, ce qui en fait un outil idéal pour un usage en classe, dans des cours de finance universitaires, ou en autoformation.',
  },
  {
    q: 'Stockade prend-il en charge les cryptomonnaies, le forex et les contrats à terme ?',
    a: 'Oui. Stockade couvre les actions, les cryptomonnaies, les paires de forex et les contrats à terme (NQ, ES, CL, GC) — retrouvez-les tous sur la <a href="/fr/markets/">page Marchés</a>.',
  },
  {
    q: 'Stockade est-il un simulateur de paper trading ou de day trading ?',
    a: 'Les deux. Avancez dans une session complète chandelier par chandelier à votre propre rythme (paper trading) ou suivez des prix en direct avec des cotations toutes les 800 ms (day trading) — le tout avec 100 000 $ d\'argent virtuel.',
  },
  {
    q: 'Qu\'est-ce qu\'un simulateur de marché boursier ?',
    a: 'Un simulateur de marché boursier est une plateforme de trading virtuelle qui reproduit les conditions réelles du marché en utilisant de l\'argent fictif, vous permettant de vous entraîner à acheter et vendre des actions, des cryptomonnaies, du forex et des contrats à terme sans risque financier. Stockade vous donne 100 000 $ de capital virtuel et des outils de niveau professionnel — graphiques en chandeliers, indicateurs techniques et plusieurs types d\'ordres — directement dans votre navigateur, sans inscription requise.',
  },
  {
    q: 'Que puis-je faire avec un simulateur de marché boursier ?',
    a: 'Vous entraîner à acheter et vendre des actions, des cryptomonnaies, des paires de forex et des contrats à terme; tester des stratégies face à des mouvements de prix simulés; <a href="/blog/analyze-trading-performance-metrics/">suivre votre performance</a> grâce à la courbe d\'équité, au taux de réussite et aux indicateurs de drawdown; et développer la reconnaissance de figures et la discipline nécessaires pour les marchés réels — le tout sans risque.',
  },
  {
    q: 'Le simulateur de marché boursier est-il réel ou fictif ?',
    a: 'L\'argent est fictif — un capital entièrement virtuel, à partir de 100 000 $, donc aucun risque financier. Les prix et les graphiques utilisent des données de marché simulées réalistes, modélisées sur le comportement réel des courtiers, de sorte que la mécanique de trading, les figures graphiques et les types d\'ordres reflètent ce que vous utiliseriez sur une plateforme réelle. L\'argent n\'est pas réel, mais les compétences acquises le sont.',
  },
  {
    q: 'Comment fonctionne un simulateur de marché boursier ?',
    a: 'Stockade génère des données de prix réalistes pour 29 actifs répartis entre actions, cryptomonnaies, forex et contrats à terme. Vous passez vos ordres via un carnet d\'ordres complet — au marché, à cours limité, stop-loss, take-profit et ordres bracket OCO — et le simulateur les exécute instantanément. Votre P&L virtuel, votre courbe d\'équité, votre taux de réussite et vos indicateurs de performance sont suivis automatiquement dans votre navigateur, sans compte requis.',
  },
  {
    q: 'Quels sont les risques liés à l\'utilisation d\'un simulateur de marché boursier ?',
    a: 'Le principal risque est de développer des habitudes qui ne tiennent pas compte de facteurs de marché réels comme le slippage, les contraintes de liquidité, les frais de courtage, et la pression psychologique liée à l\'argent réel. Stockade est conçu pour développer des compétences et éduquer, pas pour garantir des résultats de trading réel. Lorsque vous passerez aux marchés réels, commencez avec des tailles de position réduites pour vous adapter aux différences émotionnelles et d\'exécution.',
  },
  {
    q: 'Quelles sont les limites du simulateur ?',
    a: 'Stockade utilise des données de prix simulées plutôt qu\'un flux de marché en direct, si bien que les écarts de cours, le slippage et les gaps hors séance réels sont approximés plutôt que précisément reproduits. Il ne peut pas non plus reproduire pleinement la pression psychologique liée à la mise en jeu de capital réel. Voyez-le comme un terrain d\'entraînement qui couvre toutes les compétences techniques, tout en reconnaissant que la discipline émotionnelle se développe davantage sur les marchés réels.',
  },
  {
    q: 'Quel est le principal avantage d\'un simulateur ?',
    a: 'Un risque financier nul tout en développant de véritables compétences de trading. Vous pouvez tester des stratégies, faire des erreurs et développer de la discipline sans perdre d\'argent. Stockade vous donne 100 000 $ de capital virtuel et des outils professionnels — graphiques en chandeliers, EMA/VWAP/RSI/MACD, un carnet d\'ordres complet et un tableau de bord analytique détaillé — le même environnement qu\'un courtier réel, entièrement gratuit et sans conséquence.',
  },
];

const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://stockademarketsim.com/fr/#faq',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(a) },
  })),
};

const faqSchemaJson = JSON.stringify(faqSchema).replace(/</g, '\\u003c');

const liveStatsLabels = {
  startingBalance: t(locale, 'home.stats.startingBalance'),
  tradableAssets: t(locale, 'home.stats.tradableAssets'),
  assetClasses: t(locale, 'home.stats.assetClasses'),
  costToStart: t(locale, 'home.stats.costToStart'),
};
---

<Layout
  title="Stockade | Simulateur de marché boursier gratuit"
  description="Un simulateur de marché boursier gratuit avec de l'argent virtuel. Pratiquez le day trading et le paper trading avec 100 000 $ — actions, cryptomonnaies, forex, contrats à terme."
  alternates={HOME_ALTERNATES}
>
  <Fragment slot="head">
    <!-- The WebSite and Organization entities live in SiteSchema.astro and are
         emitted on every page by the base layout — those stay shared across
         locales. This SoftwareApplication node's content (name/description/
         featureList) genuinely differs per locale, so — like the FAQPage node
         below — it gets its own page-specific @id/url rather than reusing the
         English page's. -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "SoftwareApplication",
            "@id": "https://stockademarketsim.com/fr/#app",
            "name": "Stockade Simulateur de marché boursier",
            "url": "https://stockademarketsim.com/fr/",
            "inLanguage": "fr-FR",
            "applicationCategory": "FinanceApplication",
            "operatingSystem": "Web Browser",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD"
            },
            "description": "Simulateur de marché boursier en ligne gratuit pour le paper trading d'actions, de cryptomonnaies, de forex et de contrats à terme. Sans inscription requise.",
            "screenshot": "https://stockademarketsim.com/web-app-manifest-512x512.png",
            "featureList": [
              "Graphiques en chandeliers simulés avec volume",
              "Indicateurs EMA, VWAP, RSI, MACD",
              "Ordres au marché et à cours limité avec brackets OCO stop-loss / take-profit",
              "Paper trading avec un solde virtuel de 100 000 $",
              "Tableau de bord analytique avec courbe d'équité",
              "Actions, cryptomonnaies, forex et contrats à terme"
            ],
            "publisher": { "@id": "https://stockademarketsim.com/#organization" },
            "isPartOf": { "@id": "https://stockademarketsim.com/#website" }
          }
        ]
      }
    </script>
    {/* Generated from the `faqs` array above — see index.astro for why. */}
    <script type="application/ld+json" is:inline set:html={faqSchemaJson} />
  </Fragment>

  <Navbar alternates={HOME_ALTERNATES} />

  <!-- ── Hero ── -->
  <section class="relative overflow-hidden mesh-gradient">
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(var(--c-text) 1px, transparent 1px), linear-gradient(90deg, var(--c-text) 1px, transparent 1px); background-size: 40px 40px;"
    ></div>

    <div class="relative max-w-[1100px] mx-auto px-6 pt-24 pb-28 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--c-amber-bg)] border border-[var(--c-amber-dim)] text-[#f59e0b] text-[12px] font-mono mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-[#22c55e] animate-pulse"></span>
        Gratuit · Sans inscription · 100 000 $ de solde virtuel
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] mb-6">
        Entraînez-vous sur le marché.
        <br />
        <span class="gradient-text">Maîtrisez le jeu.</span>
      </h1>

      <p class="text-lg sm:text-xl text-[var(--c-text-muted)] max-w-[600px] mx-auto mb-10 leading-relaxed">
        Le simulateur de trading d'actions et de cryptomonnaies gratuit, avec des données de
        marché simulées réalistes. Sans inscription. Sans risque. Juste du trading virtuel.
      </p>

      <div class="flex flex-wrap justify-center gap-3 mb-16">
        <a
          href="/fr/simulator/"
          class="px-6 py-3 rounded-full bg-[#f59e0b] text-[#0a0a0a] font-semibold text-[15px] hover:bg-[#fbbf24] transition-colors"
        >
          Commencer à trader gratuitement →
        </a>
        <a
          href="/fr/markets/"
          class="px-6 py-3 rounded-full bg-[var(--c-bg-muted)] text-[var(--c-text)] font-semibold text-[15px] border border-[var(--c-border)] hover:bg-[var(--c-surface-2)] transition-colors"
        >
          Voir les marchés
        </a>
      </div>

      <LiveStats client:load labels={liveStatsLabels} />
    </div>
  </section>

  <!-- ── App preview ── -->
  <section class="border-y border-[var(--c-border)] bg-[var(--c-bg-soft)] px-6 py-16">
    <div class="max-w-[1100px] mx-auto">
      <div class="rounded-xl overflow-hidden border border-[var(--c-border)] shadow-2xl">
        <div class="flex items-center gap-2 px-4 py-3 bg-[var(--c-bg-muted)] border-b border-[var(--c-border)]">
          <span class="w-3 h-3 rounded-full bg-[#ef4444]"></span>
          <span class="w-3 h-3 rounded-full bg-[#f59e0b]"></span>
          <span class="w-3 h-3 rounded-full bg-[#22c55e]"></span>
          <span class="ml-3 text-[12px] font-mono text-[var(--c-text-subtle)]">stockademarketsim.com/simulator — APXL 1M</span>
          <span class="ml-auto text-[10px] font-mono text-[var(--c-text-subtle)] border border-[var(--c-border)] px-2 py-0.5 rounded tracking-wider">APERÇU EXEMPLE</span>
        </div>
        <div class="bg-[var(--c-bg-subtle)] relative overflow-hidden" style="height: 320px;">
          <svg viewBox="0 0 1200 320" class="w-full h-full" preserveAspectRatio="none">
            <line x1="0" y1="64" x2="1200" y2="64" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="128" x2="1200" y2="128" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="192" x2="1200" y2="192" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="256" x2="1200" y2="256" stroke="var(--c-border)" stroke-width="1"/>
            <defs>
              <linearGradient id="g1" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#22c55e" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="#22c55e" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path d="M0,240 C80,220 160,200 240,195 S400,165 480,150 S640,125 720,118 S900,100 960,95 S1100,80 1200,70"
              stroke="#22c55e" stroke-width="2" fill="none" opacity="0.9"/>
            <path d="M0,240 C80,220 160,200 240,195 S400,165 480,150 S640,125 720,118 S900,100 960,95 S1100,80 1200,70 V320 H0 Z"
              fill="url(#g1)"/>
          </svg>

          <div class="absolute top-4 left-4 rounded-lg px-3 py-2 border border-[var(--c-border)] backdrop-blur-sm" style="background-color: var(--c-overlay);">
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] uppercase tracking-widest mb-0.5">APXL · 1M</div>
            <div class="text-[22px] font-mono font-semibold text-[var(--c-text)]">$187.42</div>
            <div class="text-[13px] font-mono text-[#22c55e]">+1.23 (+0.66%)</div>
          </div>

          <div class="absolute top-4 right-4 w-[160px] rounded-lg border border-[var(--c-border)] p-3" style="background-color: var(--c-overlay);">
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] uppercase tracking-widest mb-2">Ordre</div>
            <div class="flex gap-1 mb-2">
              <div class="flex-1 py-1.5 bg-[var(--c-green-bg)] border border-[var(--c-green-dim)] text-[#22c55e] text-[11px] font-mono text-center rounded">ACHAT</div>
              <div class="flex-1 py-1.5 bg-[var(--c-bg-muted)] border border-[var(--c-border)] text-[var(--c-text-subtle)] text-[11px] font-mono text-center rounded">VENTE</div>
            </div>
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] mb-1">Capitaux propres</div>
            <div class="text-[14px] font-mono font-semibold text-[#22c55e]">$102,340</div>
          </div>

          <div class="absolute bottom-4 left-4 flex gap-2">
            <div class="bg-[var(--c-green-bg)] border border-[var(--c-green-dim)] rounded px-2.5 py-1.5">
              <div class="text-[10px] font-mono text-[var(--c-text-subtle)]">P&amp;L</div>
              <div class="text-[15px] font-mono font-semibold text-[#22c55e]">+$2,340</div>
            </div>
            <div class="bg-[var(--c-amber-bg)] border border-[var(--c-amber-dim)] rounded px-2.5 py-1.5">
              <div class="text-[10px] font-mono text-[var(--c-text-subtle)]">Taux de réussite</div>
              <div class="text-[15px] font-mono font-semibold text-[#f59e0b]">68%</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features ── -->
  <section class="py-24 px-6 bg-[var(--c-bg)]">
    <div class="max-w-[1100px] mx-auto">
      <div class="text-center mb-14">
        <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-3">Pourquoi Stockade</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)]">Tout ce dont un trader sérieux a besoin.</h2>
        <p class="mt-4 text-[var(--c-text-muted)] text-lg max-w-[480px] mx-auto">
          Conçu pour apprendre, pas pour jouer. Des outils professionnels sans le prix qui va avec.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: '📈', title: 'Vrais graphiques en chandeliers', desc: 'Chandeliers complets avec volume, superposés d\'indicateurs EMA, VWAP, RSI et MACD — les mêmes outils qu\'utilisent les professionnels.' },
          { icon: '⚡', title: 'Exécution instantanée',          desc: 'Ordres au marché, à cours limité, stop-loss, take-profit et bracket OCO exécutés instantanément.' },
          { icon: '⌨️', title: 'Raccourcis clavier',              desc: 'B pour acheter, S pour vendre, F pour clôturer. Tradez à la vitesse de la pensée sans toucher la souris.' },
          { icon: '📊', title: 'Tableau de bord analytique',      desc: 'Taux de réussite, facteur de profit, gain/perte moyen, courbe d\'équité, drawdown et cartes de chaleur par plage horaire.' },
          { icon: '💼', title: 'Multi-actifs',                    desc: 'Actions, cryptomonnaies, paires de forex et contrats à terme — tout dans un seul simulateur.' },
          { icon: '📱', title: 'Pensé mobile',                    desc: 'Entièrement responsive. Tradez depuis votre téléphone, votre tablette ou votre ordinateur avec les mêmes fonctionnalités.' },
          { icon: '🆓', title: '100 % gratuit, pour toujours',    desc: 'Toutes les fonctionnalités. Tous les actifs. Pas d\'inscription. Pas d\'essai. Pas d\'abonnement. Il suffit de commencer.' },
        ].map(f => (
          <div class="bg-[var(--c-bg-soft)] border border-[var(--c-border)] rounded-xl p-5 hover:border-[var(--c-border-strong)] transition-colors group">
            <div class="text-2xl mb-3">{f.icon}</div>
            <h3 class="text-[15px] font-semibold text-[var(--c-text)] mb-2 group-hover:text-[#f59e0b] transition-colors">{f.title}</h3>
            <p class="text-[13px] text-[var(--c-text-subtle)] leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Asset coverage ── -->
  <section class="py-20 px-6 bg-[var(--c-bg-soft)] border-y border-[var(--c-border)]">
    <div class="max-w-[1100px] mx-auto">
      <div class="text-center mb-12">
        <div class="text-[11px] font-mono uppercase tracking-widest text-[#22c55e] mb-3">Actifs couverts</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)]">Tradez de tout.</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {[
          { label: 'Actions',            sub: 'Actions · 14 tickers',              icon: '📈', color: '#3b82f6' },
          { label: 'Cryptomonnaies',      sub: 'Jetons et pièces · 8 actifs',       icon: '🪙', color: '#f59e0b' },
          { label: 'Forex',              sub: 'EUR/USD · GBP/USD · USD/JPY',       icon: '💱', color: '#22c55e' },
          { label: 'Contrats à terme',   sub: 'NQ · ES · CL · GC',                 icon: '🔮', color: '#8b5cf6' },
        ].map(a => (
          <div class="bg-[var(--c-bg)] border border-[var(--c-border)] rounded-xl p-5 text-center hover:border-[var(--c-border-strong)] transition-colors">
            <div class="text-3xl mb-3">{a.icon}</div>
            <div class="text-[16px] font-semibold mb-1" style={`color: ${a.color}`}>{a.label}</div>
            <div class="text-[12px] font-mono text-[var(--c-text-subtle)]" set:html={a.sub}></div>
          </div>
        ))}
      </div>
      <p class="text-center text-[11px] font-mono text-[var(--c-text-subtle)] mt-6">
        Tous les tickers sont des actifs simulés fictifs et ne représentent ni des titres réels, ni des cryptomonnaies, ni des instruments négociables.
      </p>
    </div>
  </section>

  <!-- ── SEO Content ── -->
  <section class="py-24 px-6 bg-[var(--c-bg-soft)] border-t border-[var(--c-border)]">
    <div class="max-w-[800px] mx-auto">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-4">À propos de Stockade</div>
      <article class="prose-stockade">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)] mb-6">
          Pratiquez le marché sans mettre d'argent en jeu
        </h2>

        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
Stockade est un <a href="/fr/simulator/" class="text-[#f59e0b] hover:underline">simulateur de marché boursier</a> que vous ouvrez dans un onglet de navigateur et que vous commencez à utiliser une dizaine de secondes plus tard. Vous disposez de <strong class="text-[var(--c-text)]">100 000 $ d'argent virtuel</strong> et d'un environnement de trading complet couvrant les actions, les cryptomonnaies, le forex et les contrats à terme. Aucun compte à créer, aucune carte à renseigner, rien à installer. Faites un trade catastrophique et la seule chose que vous perdez est un chiffre sur un écran — c'est justement à ça que sert le trading d'entraînement.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Pourquoi la plupart des jeux de trading tombent à plat
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Beaucoup de simulateurs sont optimisés pour l'engagement plutôt que pour le réalisme. Ils suppriment les indicateurs, les types d'ordres et les indicateurs de risque, et ce qui reste est un jeu où l'on regarde un chiffre monter — amusant pour un après-midi, mais qui n'apprend presque rien qui survive au contact d'un véritable courtier. Nous avons fait le choix inverse. Stockade vous offre des graphiques en chandeliers avec histogrammes de volume, des superpositions EMA 9/20/50, le VWAP, le RSI et le MACD, ainsi qu'un carnet d'ordres avec des entrées au marché et à cours limité et des niveaux de stop-loss / take-profit qui fonctionnent comme un ordre bracket OCO. L'idée est que les habitudes que vous développez ici restent valables lorsque vous passez à une plateforme réelle — voir <a href="/blog/paper-trading-guide/" class="text-[#f59e0b] hover:underline">le guide du paper trading</a> pour savoir comment faire durer cette transition.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Deux façons de s'entraîner: en direct et en relecture
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Le mode direct diffuse six actifs à la fois avec des prix mis à jour toutes les 800 millisecondes, vous permettant de pratiquer le day trading face à un flux rapide et de découvrir comment vous vous comportez réellement sous pression. Le mode relecture fait l'inverse — vous avancez dans une session complète un chandelier à la fois, en prenant le temps qu'il vous faut sur chaque décision. La plupart des gens utilisent le mode direct pour développer leurs réflexes et le mode relecture pour développer la reconnaissance de figures — pour un entraînement centré uniquement sur la lecture des formations plutôt que sur le P&amp;L, le <a href="/fr/chart-simulator/" class="text-[#f59e0b] hover:underline">simulateur de graphiques</a> avance de la même façon à travers les figures en chandeliers. Les simulateurs de paper trading gérés par des courtiers exigent généralement une inscription et un compte réel lié avant de vous laisser passer un seul ordre. Ici, il suffit d'ouvrir la page.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Actions, cryptomonnaies, forex et contrats à terme au même endroit
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Il y a 14 actions au comportement de prix réaliste, 8 cryptomonnaies qui évoluent avec la volatilité que vous attendriez de vraies devises numériques, des paires de devises majeures et mineures, et quatre contrats à terme — NQ, ES, CL et GC. Cette diversité compte plus qu'il n'y paraît: une stratégie qui semble brillante sur une action peu volatile s'effondre souvent sur une paire de devises ou un contrat à terme, et avoir tout réuni sur <a href="/fr/markets/" class="text-[#f59e0b] hover:underline">une seule plateforme</a> permet de le découvrir facilement.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Analysez ce qui s'est réellement passé
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Passer des ordres est la partie facile; la partie utile consiste à décortiquer les résultats ensuite. Le <a href="/fr/analytics/" class="text-[#f59e0b] hover:underline">tableau de bord analytique</a> lit votre historique de trades et affiche la courbe d'équité, le taux de réussite, le facteur de profit, le gain et la perte moyens, le drawdown maximal, et une carte de chaleur montrant à quelles heures de la journée vos trades ont réellement fonctionné. Comme il n'y a rien à installer et aucune barrière d'inscription, tout ce cycle se déroule dans un onglet de navigateur — ce qui le rend aussi utilisable pour une salle de classe ou un groupe d'étude, où faire passer tout le monde par un formulaire d'inscription est généralement la partie la plus difficile.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Pas de paywall, pas d'offre premium
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-4">
          De nombreuses plateformes gardent leurs meilleurs outils derrière un abonnement, ou vous demandent une adresse e-mail avant de pouvoir passer le moindre trade. Ce n'est pas le cas de Stockade. Tout est inclus ici, en permanence:
        </p>
        <ul class="space-y-2 mb-6 ml-4">
          {[
            'Graphiques en chandeliers complets avec volume',
            'Indicateurs professionnels: EMA, VWAP, RSI, MACD',
