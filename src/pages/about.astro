---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { ABOUT_ALTERNATES } from '../i18n/alternates';
---

<Layout
  title="About Stockade | Trading Simulator for Beginners"
  description="Learn about Stockade, the free browser-based stock market simulator built for traders who want to practice without risk. No signup, no money, no limits."
  alternates={ABOUT_ALTERNATES}
>
  <Navbar alternates={ABOUT_ALTERNATES} />

  <main class="max-w-[760px] mx-auto px-6 py-16">

    <div class="mb-12">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-3">About</div>
      <h1 class="text-4xl font-bold tracking-tight text-[var(--c-text)] mb-4">
        Built for traders who want to learn, not gamble.
      </h1>
      <p class="text-[17px] text-[var(--c-text-muted)] leading-relaxed">
        Stockade is a free, browser-based paper trading simulator that lets anyone practice trading
        stocks, crypto, forex, and futures with $100,000 in virtual money — no signup, no credit
        card, no risk.
      </p>
    </div>

    <!-- Who built this -->
    <section class="mb-12 pb-12 border-b border-[var(--c-border)]">
      <div class="flex items-center gap-3 mb-5">
        <div
          class="shrink-0 w-9 h-9 rounded-lg bg-[var(--c-amber-bg)] border border-[var(--c-amber-dim)] flex items-center justify-center"
          aria-hidden="true"
        >
          <!-- Generic graduation cap. No photo, avatar, initials, or name is
               used here — the people behind the project stay unidentified. -->
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 3L18.5 7L10 11L1.5 7L10 3Z" />
            <path d="M5 9v4.5c0 1.1 2.24 2 5 2s5-.9 5-2V9" />
            <path d="M18.5 7v4.5" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-[var(--c-text)]">About this project</h2>
      </div>

      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed mb-4">
        Stockade is built and maintained by a developer with a Computer Science and Engineering
        background and an interest in financial markets and trading systems. The project started
        as a way to practice trading strategies without financial risk, after finding that most
        existing simulators were either paywalled, cluttered with real-money brokerage upsells, or
        too simplistic to reflect how actual markets behave — and has grown into a full practice
        environment for learning to trade. It's meant to work as a trading simulator for beginners
        just as well as a sandbox for traders who already have live experience.
      </p>

      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed mb-4">
        The site covers four areas: a <a href="/simulator" class="text-[#f59e0b] hover:underline">stock market simulator</a> with realistic order types (market,
        limit, stop-loss, OCO/bracket orders), a <a href="/chart-simulator" class="text-[#f59e0b] hover:underline">chart replay tool</a> for practicing technical analysis
        on historical-style price action, an <a href="/analytics" class="text-[#f59e0b] hover:underline">analytics dashboard</a> for reviewing trade performance and
        identifying behavioral patterns, and a growing <a href="/blog" class="text-[#f59e0b] hover:underline">library of educational articles</a> on trading
        concepts, indicators, and strategy. All trading data — tickers, prices, and market movement —
        is simulated rather than pulled from real markets, and this is stated clearly wherever it
        could otherwise be mistaken for live data.
      </p>

      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed mb-4">
        Where a feature has real limitations — for instance, the simulator does not currently model
        slippage or partial fills the way a live exchange would — that's noted directly on the
        relevant page rather than left implied. Educational content is written to be accurate to real
        trading concepts even though the practice environment itself is simulated, and calculation
        logic (like P&amp;L and performance metrics) is checked against standard trading formulas
        during development.
      </p>

      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        This is an independent project and is not affiliated with any brokerage, exchange, or
        financial institution. Nothing on this site constitutes financial advice.
      </p>
    </section>

    <!-- What you get -->
    <section class="mb-12 pb-12 border-b border-[var(--c-border)]">
      <h2 class="text-xl font-bold text-[var(--c-text)] mb-6">What Stockade gives you</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          {
            title: 'Full candlestick charts',
            desc: 'Full OHLCV candlestick charts with volume histograms — the same chart type used by professional traders worldwide.',
          },
          {
            title: 'Professional indicators',
            desc: 'EMA 9/20/50, VWAP, RSI, and MACD overlays built in. No subscriptions, no extras required.',
          },
          {
            title: 'Complete order panel',
            desc: 'Market and limit entries, plus optional stop-loss and take-profit levels that work as an OCO bracket — whichever level price reaches first closes the position and cancels the other.',
          },
          {
            title: 'Performance analytics',
            desc: 'Equity curve, win rate, profit factor, average win/loss, max drawdown, and a time-of-day heatmap.',
          },
          {
            title: 'Multi-asset coverage',
            desc: 'Trade <a href="/markets" class="text-[#f59e0b] hover:underline">29 simulated assets</a>: 14 equity tickers, 8 crypto tokens, major forex pairs, and futures (NQ, ES, CL, GC).',
          },
          {
            title: 'Live & replay modes',
            desc: '800ms live ticks for real-time practice, or step through a full session candle-by-candle at your own pace.',
          },
          {
            title: '100% free, forever',
            desc: 'No trials, no freemium tiers, no upsells. Every feature is included at no cost, always.',
          },
        ].map(f => (
          <div class="bg-[var(--c-bg-soft)] border border-[var(--c-border)] rounded-xl p-5">
            <h3 class="text-[14px] font-semibold text-[var(--c-text)] mb-1.5">{f.title}</h3>
            <p class="text-[13px] text-[var(--c-text-subtle)] leading-relaxed" set:html={f.desc} />
          </div>
        ))}
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="mb-12 pb-12 border-b border-[var(--c-border)]">
      <h2 class="text-xl font-bold text-[var(--c-text)] mb-4">Not financial advice</h2>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        Stockade is an educational and entertainment platform only. All trading is conducted with
        virtual money that has no real-world value. Nothing on this site constitutes financial,
        investment, legal, or tax advice. Past simulated performance does not indicate future
        real-world results. Please consult a licensed financial adviser before making any real
        investment decisions.
      </p>
    </section>

    <!-- Contact CTA -->
    <section>
      <h2 class="text-xl font-bold text-[var(--c-text)] mb-4">Get in touch</h2>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed mb-5">
        Have a question, suggestion, or found a bug? We'd love to hear from you, and feedback
        genuinely shapes what gets worked on next.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#f59e0b] text-[#0a0a0a] font-semibold text-[14px] hover:bg-[#fbbf24] transition-colors"
      >
        Contact us →
      </a>
    </section>

  </main>

  <Footer />
</Layout>
