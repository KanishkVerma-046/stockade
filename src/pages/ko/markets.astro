---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import MarketsView from '../../components/markets/MarketsView.tsx';
import { MARKETS_ALTERNATES, localizedHref } from '../../i18n/alternates';
import { t } from '../../i18n/ui';

const locale = 'ko' as const;
const marketsLabels = {
  trade: t(locale, 'markets.trade'),
  volumeAll: t(locale, 'markets.volume.all'),
  volumeShares: t(locale, 'markets.volume.shares'),
  volumeUsd: t(locale, 'markets.volume.usd'),
  volumeContracts: t(locale, 'markets.volume.contracts'),
  search: t(locale, 'markets.search'),
  categories: {
    all: t(locale, 'markets.category.all'),
    stock: t(locale, 'markets.category.stock'),
    crypto: t(locale, 'markets.category.crypto'),
    forex: t(locale, 'markets.category.forex'),
    futures: t(locale, 'markets.category.futures'),
  },
  colSymbol: t(locale, 'markets.col.symbol'),
  colName: t(locale, 'markets.col.name'),
  colPrice: t(locale, 'markets.col.price'),
  colChange: t(locale, 'markets.col.change'),
  colVolume: t(locale, 'markets.col.volume'),
  colMktCap: t(locale, 'markets.col.mktCap'),
  colAction: t(locale, 'markets.col.action'),
  assetNames: {
    'EUR/USD': t(locale, 'markets.asset.EURUSD'),
    'GBP/USD': t(locale, 'markets.asset.GBPUSD'),
    'USD/JPY': t(locale, 'markets.asset.USDJPY'),
    '/ES': t(locale, 'markets.asset.ES'),
    '/NQ': t(locale, 'markets.asset.NQ'),
    '/CL': t(locale, 'markets.asset.CL'),
    '/GC': t(locale, 'markets.asset.GC'),
  },
};
---

<Layout
  title="주식, 암호화폐, 외환, 선물 마켓 | Stockade"
  description="무료 온라인 주식 시장 시뮬레이터에서 주식, 암호화폐, 외환, 선물 등 29개 시뮬레이션 자산을 확인하세요. 가입이 필요하지 않습니다."
  alternates={MARKETS_ALTERNATES}
>
  <Navbar alternates={MARKETS_ALTERNATES} />
  <main class="max-w-[1400px] mx-auto px-4 py-8">
    <div class="mb-8">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-2">마켓</div>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--c-text)]">마켓 개요</h1>
      <p class="mt-2 text-[var(--c-text-subtle)] text-[14px]">이 마켓 개요는 주식, 암호화폐, 외환, 선물 등 29개 시뮬레이션 자산에 대해 2초마다 갱신됩니다. 암호화폐 트레이딩 시뮬레이터의 관심 종목 목록으로, 외환 시뮬레이터 스캐너로, 혹은 트레이딩 전에 가격을 빠르게 확인하는 용도로 사용해보세요. 가격 변동률 기준으로 정렬해 가장 활발히 움직이는 자산을 확인하고, 바로 옆의 거래량 열도 함께 살펴보세요 — 이 숫자가 실제로 무엇을 의미하는지는 <a href="/ko/blog/georaeryang-ihaehagi/" class="text-[#f59e0b] hover:underline">거래량 이해하기</a>에서 확인하실 수 있습니다. 800밀리초 간격으로 갱신되는 시뮬레이션 가격을 원하시면 <a href="/ko/simulator/" class="text-[#f59e0b] hover:underline">트레이딩 시뮬레이터</a>를 이용하세요.</p>
    </div>
    <MarketsView
      client:load
      simulatorHref={localizedHref('/simulator/', locale)}
      labels={marketsLabels}
    />

    <section class="mt-16 pt-12 border-t border-[var(--c-border)] max-w-[820px]">
      <h2 class="text-xl font-bold tracking-tight text-[var(--c-text)] mb-4">
        마켓 개요 사용법
      </h2>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        이 표는 Stockade가 제공하는 29개 시뮬레이션 자산 전체를 다룹니다 — 주식 14개, 암호화폐 토큰 8개, 외환 페어 3개, 선물 종목 4개. 가격이 2초마다 갱신되므로 거래를 시작하지 않고도 자산군별 움직임을 지켜볼 수 있습니다.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">필터링과 정렬</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        카테고리 탭으로 표를 하나의 자산군으로 좁히거나, 검색창으로 심볼이나 이름을 바로 찾을 수 있습니다. 심볼, 가격, 변동률 열 머리글 중 하나를 클릭하면 해당 항목으로 정렬되고, 다시 클릭하면 순서가 반대로 바뀝니다. 기본 보기는 변동률 순으로 정렬되어 있어 가장 크게 움직이는 자산이 먼저 표시됩니다.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">열 읽는 법</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        가격과 변동률은 보이는 그대로지만, 거래량은 자산군마다 단위가 다릅니다 — 주식은 거래된 주식 수, 암호화폐와 외환은 거래된 미국 달러 금액, 선물은 계약 수입니다 — 각 시장이 실제로 쓰는 관례를 따르기 때문입니다. 시가총액은 주식과 암호화폐에만 해당하며, 외환 페어와 선물에는 개념 자체가 맞지 않아 <span class="font-mono">—</span>로 표시됩니다.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">표에서 바로 거래하기</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        각 행의 거래하기 버튼을 누르면 해당 심볼이 이미 선택된 상태로 <a href={localizedHref('/simulator/', locale)} class="text-[#f59e0b] hover:underline">트레이딩 시뮬레이터</a>가 열리므로, 여기서 움직이는 종목을 발견한 뒤 다시 검색하지 않고 바로 주문을 넣을 수 있습니다. 판단을 내리기 전에 가격 움직임이 캔들 하나씩 펼쳐지는 모습을 보고 싶다면, <a href={localizedHref('/chart-simulator/', locale)} class="text-[#f59e0b] hover:underline">차트 시뮬레이터</a>에서 같은 자산군을 봉 하나씩 재생할 수 있습니다.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
