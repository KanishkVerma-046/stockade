---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { CONTACT_ALTERNATES } from '../../i18n/alternates';
---

<Layout
  title="문의하기 | Stockade"
  description="무료 주식 시장 시뮬레이터 Stockade에 대한 피드백을 남겨주세요. 버그, 아이디어, 그 밖의 의견도 몇 초 만에 전달할 수 있습니다."
  alternates={CONTACT_ALTERNATES}
>
  <Navbar alternates={CONTACT_ALTERNATES} />

  <main class="max-w-[680px] mx-auto px-6 py-16">

    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-3">문의</div>
      <h1 class="text-4xl font-bold tracking-tight text-[var(--c-text)] mb-3">의견을 들려주세요</h1>
      <p class="text-[16px] text-[var(--c-text-muted)] leading-relaxed">
        사용 경험을 평가해주시고, 의견이나 버그 제보, 아이디어를 아래에 남겨주세요 —
        모든 의견을 빠짐없이 읽고 있습니다.
      </p>
    </div>

    <!-- Google Form embed -->
    <div class="bg-[var(--c-bg-soft)] border border-[var(--c-border)] rounded-xl p-2 sm:p-3 mb-12">
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSfA5TEf_AHaCuygyjHEOOZm3LFKrziqaoKJCn1s8CAvbsVXWQ/viewform?embedded=true"
        title="Stockade 피드백 양식"
        width="100%"
        height="700"
        style="border: 0; border-radius: 0.5rem;"
        loading="lazy"
      >로딩 중…</iframe>
    </div>

    <!-- FAQ nudge -->
    <div class="mt-8 bg-[var(--c-bg-soft)] border border-[var(--c-border)] rounded-xl p-5">
      <p class="text-[13px] text-[var(--c-text-subtle)] leading-relaxed">
        빠른 답을 찾고 계신가요? 홈페이지의 <a href="/ko/#faq" class="text-[#f59e0b] hover:text-[#fbbf24] underline underline-offset-2">FAQ</a> 섹션을
        확인해보세요 — 시뮬레이터 작동 방식에 관한 가장 흔한 질문들을 다루고 있습니다.
      </p>
    </div>

  </main>

  <Footer />
</Layout>
