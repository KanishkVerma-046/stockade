---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import LegalTranslationNotice from '../../components/layout/LegalTranslationNotice.astro';
import { TERMS_ALTERNATES } from '../../i18n/alternates';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';

const locale: Locale = 'ko';
---

<Layout
  title="이용약관 | Stockade"
  description="Stockade의 이용약관을 확인하세요. 무료 트레이딩 시뮬레이터를 이용함으로써 여러분은 본 약관에 동의하게 됩니다. 실제 자금도, 투자 자문도 아닙니다."
  alternates={TERMS_ALTERNATES}
>
  <Navbar alternates={TERMS_ALTERNATES} />

  <main class="max-w-[760px] mx-auto px-6 py-16">

    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-3">{t(locale, 'footer.legal')}</div>
      <h1 class="text-4xl font-bold tracking-tight text-[var(--c-text)] mb-3">이용약관</h1>
      <p class="text-[13px] font-mono text-[var(--c-text-subtle)]">최종 업데이트: 2026년 6월 22일</p>
    </div>

    <LegalTranslationNotice locale={locale} englishHref="/terms/" />

    <div class="prose-legal">

      <section>
        <h2>약관 동의</h2>
        <p>stockademarketsim.com에서 Stockade("서비스")에 접속하거나 이용함으로써, 여러분은 본 이용약관에 구속되는 것에 동의합니다. 본 약관의 어느 부분에도 동의하지 않는 경우, 서비스를 이용할 수 없습니다. 당사는 언제든지 본 약관을 업데이트할 권리를 보유하며, 변경 후에도 서비스를 계속 이용하는 것은 개정된 약관에 대한 동의로 간주됩니다.</p>
      </section>

      <section>
        <h2>서비스 설명</h2>
        <p>Stockade는 <strong>무료 브라우저 기반 주식 및 암호화폐 트레이딩 시뮬레이터</strong>입니다. 본 서비스는 오직 교육 및 오락 목적으로 제공됩니다. Stockade에서의 모든 거래는 실제 금전적 가치가 없는 가상의 시뮬레이션 자금으로 이루어집니다. 본 서비스를 통해 실제 자산, 통화, 금융 상품이 매수, 매도, 이전되는 일은 없습니다.</p>
        <p>Stockade는 회원가입을 요구하지 않으며, 호환되는 웹 브라우저만 있으면 누구나 즉시 이용할 수 있습니다. 여러분의 시뮬레이션 데이터는 브라우저에 로컬로 저장되며, 당사 서버에는 보관되지 않습니다.</p>
      </section>

      <section>
        <h2>투자 자문이 아닙니다</h2>
        <p><strong>Stockade의 어떠한 내용도 재무, 투자, 법률, 세무 자문에 해당하지 않습니다.</strong> 본 서비스는 오직 사용자가 위험 없는 시뮬레이션 환경에서 트레이딩 메커니즘을 학습하도록 돕기 위해 설계되었습니다. 시뮬레이터 내에서 관찰된 어떠한 전략, 기법, 결과도 실제 금융 시장에서의 거래에 대한 조언을 나타내지 않으며, 과거의 시뮬레이션 성과는 미래의 실제 결과를 나타내지 않습니다.</p>
        <p>실제 투자 결정을 내리기 전에는 반드시 공인 재무 자문가와 상담해야 합니다.</p>
      </section>

      <section>
        <h2>허용되는 이용</h2>
        <p>여러분은 합법적이고 개인적이며 비상업적인 목적으로만 본 서비스를 이용할 수 있습니다. 여러분은 다음 행위를 하지 않을 것에 동의합니다:</p>
        <ul>
          <li>서비스를 불법적인 목적으로 이용하거나 관련 법률을 위반하는 방식으로 이용하는 행위</li>
          <li>서비스를 역설계, 스크래핑하거나 체계적으로 데이터를 추출하려 시도하는 행위</li>
          <li>서비스에 악성코드, 바이러스 또는 그 밖의 악의적인 코드를 유입시키는 행위</li>
          <li>상업적 이익을 위해 또는 타인을 오도하기 위해 시뮬레이션 결과를 실제 트레이딩 성과인 것처럼 허위로 제시하는 행위</li>
          <li>서비스의 정상적인 운영을 방해하는 방식으로 자동화된 봇이나 스크립트를 이용해 서비스와 상호작용하는 행위</li>
        </ul>
      </section>

      <section>
        <h2>가상 통화</h2>
        <p>시뮬레이터 내에서 제공되는 가상 잔고(미화 10만 달러 상당으로 시작)는 어떠한 금전적 가치도 없으며, 실제 돈이나 그 밖의 자산으로 인출, 이전, 교환, 환전할 수 없습니다. Stockade 내에서 가상의 수익을 쌓더라도 어떠한 금전적 권리나 자격도 발생하지 않습니다.</p>
      </section>

      <section>
        <h2>보증의 부인</h2>
        <p>본 서비스는 상품성, 특정 목적에의 적합성, 비침해에 대한 묵시적 보증을 포함하되 이에 국한되지 않는 어떠한 명시적 또는 묵시적 보증 없이 <strong>"있는 그대로"</strong> 및 <strong>"제공 가능한 상태 그대로"</strong> 제공됩니다. 당사는 서비스가 중단 없이 또는 오류 없이 제공될 것을 보증하지 않습니다.</p>
        <p>Stockade에서 사용되는 시뮬레이션 가격 데이터는 알고리즘으로 생성되며 실제 시장 가격을 나타내지 않습니다. 실제 시장 움직임과의 유사성은 우연에 불과합니다.</p>
      </section>

      <section>
        <h2>책임의 제한</h2>
        <p>법률이 허용하는 최대한의 범위 내에서, Stockade와 그 운영자는 여러분의 서비스 이용 또는 이용 불능으로 인해 발생하는 어떠한 간접적, 부수적, 특별, 결과적 또는 징벌적 손해에 대해서도 책임을 지지 않으며, 여기에는 시뮬레이터에서 테스트한 전략의 결과로 실제 시장에서 발생한 금전적 손실도 포함되나 이에 국한되지 않습니다.</p>
      </section>

      <section>
        <h2>서비스 종료</h2>
        <p>당사는 유지보수, 업데이트, 영구 폐쇄를 포함한 어떠한 이유로든, 사전 통지 여부와 관계없이 언제든지 서비스를 중단하거나 종료할 권리를 보유합니다. 당사 서버에는 계정이나 개인 데이터가 보관되지 않으므로, 종료 시 삭제할 데이터도 존재하지 않습니다.</p>
      </section>

      <section>
        <h2>준거법</h2>
        <p>본 약관은 법률 저촉 조항과 관계없이 적용 가능한 법률에 따라 규율되고 해석됩니다. 본 약관 또는 서비스로부터 발생하는 모든 분쟁은 해당 관할권의 관할 법원의 전속 관할에 따릅니다.</p>
      </section>

      <section>
        <h2>문의</h2>
        <p>본 이용약관에 대한 문의는 <a href="mailto:hello@stockademarketsim.com">hello@stockademarketsim.com</a>으로 보내주시기 바랍니다.</p>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .prose-legal {
    color: var(--c-text-muted);
    font-size: 15px;
    line-height: 1.8;
  }
  .prose-legal section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--c-border);
  }
  .prose-legal section:last-child {
    border-bottom: none;
  }
  .prose-legal h2 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--c-text);
    margin-bottom: 0.75rem;
    margin-top: 0;
  }
  .prose-legal p {
    margin-bottom: 0.9rem;
  }
  .prose-legal ul {
    margin: 0.5rem 0 0.9rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .prose-legal li {
    list-style: disc;
  }
  .prose-legal a {
    color: #f59e0b;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-legal a:hover {
    color: #fbbf24;
  }
  .prose-legal strong {
    color: var(--c-text);
    font-weight: 600;
  }
</style>
