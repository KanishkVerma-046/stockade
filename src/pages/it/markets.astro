---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import MarketsView from '../../components/markets/MarketsView.tsx';
import { MARKETS_ALTERNATES } from '../../i18n/alternates';
---

<Layout
  title="Azioni, Crypto, Forex e Futures | Stockade"
  description="Monitora 29 asset simulati tra azioni, crypto, forex e futures sul nostro simulatore di borsa online gratuito. Nessuna registrazione richiesta."
  alternates={MARKETS_ALTERNATES}
>
  <Navbar alternates={MARKETS_ALTERNATES} />
  <main class="max-w-[1400px] mx-auto px-4 py-8">
    <div class="mb-8">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-2">Mercati</div>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--c-text)]">Panoramica dei mercati</h1>
      <p class="mt-2 text-[var(--c-text-subtle)] text-[14px]">Questa panoramica dei mercati si aggiorna ogni 2 secondi su 29 asset simulati — azioni, crypto, forex e futures. Usala come watchlist di un simulatore di trading crypto, come scanner di un simulatore forex, o semplicemente per controllare rapidamente i prezzi prima di operare. Ordina per variazione di prezzo per vedere quali asset si stanno muovendo di più, e controlla anche la colonna del volume — scopri cosa significa davvero quel numero in <a href="/it/blog/comprendere-il-volume-di-trading" class="text-[#f59e0b] hover:underline">comprendere il volume di trading</a>. Per tick in tempo reale ogni 800ms, usa il <a href="/it/simulator/" class="text-[#f59e0b] hover:underline">Simulatore di Trading</a>.</p>
    </div>
    <MarketsView client:load />
  </main>
  <Footer />
</Layout>
