---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import TickerTape from '../../components/landing/TickerTape.tsx';
import LiveStats from '../../components/landing/LiveStats.tsx';
import { HOME_ALTERNATES } from '../../i18n/alternates';
import { t } from '../../i18n/ui';

const locale = 'de' as const;

// Single source of truth for the FAQ: the visible section below and the
// FAQPage JSON-LD are both generated from this array. Mirrors the structure
// of the English src/pages/index.astro — see that file for why the schema is
// generated rather than hand-duplicated.
const faqs = [
  {
    q: 'Ist Stockade komplett kostenlos?',
    a: 'Ja — 100 % kostenlos, für immer. Alle Funktionen, alle Anlageklassen, alle Tools. Keine Anmeldung, keine Kreditkarte, kein Abonnement erforderlich.',
  },
  {
    q: 'Können Studierende Stockade als Börsensimulator nutzen?',
    a: 'Absolut. Stockade ist einer der besten kostenlosen Börsensimulatoren für Studierende. Es ist keine Installation und kein Konto erforderlich, was es ideal für den Unterrichtseinsatz, universitäre Finanzkurse oder das Selbststudium macht.',
  },
  {
    q: 'Unterstützt Stockade Kryptowährungen, Forex und Futures?',
    a: 'Ja. Stockade deckt Aktien, Kryptowährungen, Forex-Paare und Futures (NQ, ES, CL, GC) ab — alle zu finden auf der <a href="/de/markets/">Märkte-Seite</a>.',
  },
  {
    q: 'Ist Stockade ein Paper-Trading- oder ein Day-Trading-Simulator?',
    a: 'Beides. Durchlaufen Sie eine komplette Sitzung Kerze für Kerze in Ihrem eigenen Tempo (Paper Trading) oder folgen Sie Live-Kursen mit Tick-Updates alle 800 ms (Day Trading) — beides mit 100.000 $ virtuellem Guthaben.',
  },
  {
    q: 'Was ist ein Börsensimulator?',
    a: 'Ein Börsensimulator ist eine virtuelle Handelsplattform, die reale Marktbedingungen mit fiktivem Geld nachbildet und es Ihnen ermöglicht, den Kauf und Verkauf von Aktien, Kryptowährungen, Forex und Futures ohne finanzielles Risiko zu üben. Stockade gibt Ihnen 100.000 $ virtuelles Kapital und Tools auf professionellem Niveau — Candlestick-Charts, technische Indikatoren und mehrere Ordertypen — direkt im Browser, ohne Anmeldung.',
  },
  {
    q: 'Was kann ich mit einem Börsensimulator tun?',
    a: 'Den Kauf und Verkauf von Aktien, Kryptowährungen, Forex-Paaren und Futures üben; Strategien gegen simulierte Kursbewegungen testen; <a href="/blog/analyze-trading-performance-metrics/">Ihre Performance verfolgen</a> über Equity-Kurve, Trefferquote und Drawdown-Kennzahlen; und die Mustererkennung sowie Disziplin entwickeln, die für reale Märkte nötig sind — alles ohne Risiko.',
  },
  {
    q: 'Ist der Börsensimulator echt oder fiktiv?',
    a: 'Das Geld ist fiktiv — vollständig virtuelles Kapital, beginnend bei 100.000 $, also kein finanzielles Risiko. Kurse und Charts basieren auf realistischen simulierten Marktdaten, die am tatsächlichen Verhalten von Brokern ausgerichtet sind, sodass Handelsmechanik, Chartmuster und Ordertypen widerspiegeln, was Sie auf einer echten Plattform nutzen würden. Das Geld ist nicht real, aber die erlernten Fähigkeiten sind es.',
  },
  {
    q: 'Wie funktioniert ein Börsensimulator?',
    a: 'Stockade generiert realistische Kursdaten für 29 Assets aus den Bereichen Aktien, Kryptowährungen, Forex und Futures. Sie geben Ihre Orders über ein vollständiges Orderbuch auf — Market-, Limit-, Stop-Loss-, Take-Profit- und OCO-Bracket-Orders — und der Simulator führt sie sofort aus. Ihr virtueller P&L, Ihre Equity-Kurve, Trefferquote und weitere Performance-Kennzahlen werden automatisch in Ihrem Browser erfasst, ohne dass ein Konto erforderlich ist.',
  },
  {
    q: 'Welche Risiken birgt die Nutzung eines Börsensimulators?',
    a: 'Das Hauptrisiko besteht darin, Gewohnheiten zu entwickeln, die reale Marktfaktoren wie Slippage, Liquiditätsengpässe, Brokergebühren und den psychologischen Druck durch echtes Geld außer Acht lassen. Stockade ist auf Kompetenzaufbau und Bildung ausgelegt, nicht auf die Garantie realer Handelsergebnisse. Beginnen Sie beim Übergang zu echten Märkten mit kleineren Positionsgrößen, um sich an emotionale und ausführungsbedingte Unterschiede zu gewöhnen.',
  },
  {
    q: 'Was sind die Grenzen des Simulators?',
    a: 'Stockade verwendet simulierte Kursdaten statt eines Live-Marktfeeds, sodass reale Kursabweichungen, Slippage und Kurslücken außerhalb der Handelszeiten angenähert statt exakt nachgebildet werden. Er kann auch den psychologischen Druck, der mit dem Einsatz von echtem Kapital einhergeht, nicht vollständig abbilden. Betrachten Sie ihn als Trainingsumgebung, die alle technischen Fähigkeiten abdeckt, während emotionale Disziplin sich stärker an echten Märkten entwickelt.',
  },
  {
    q: 'Was ist der größte Vorteil eines Simulators?',
    a: 'Null finanzielles Risiko bei gleichzeitigem Aufbau echter Handelsfähigkeiten. Sie können Strategien testen, Fehler machen und Disziplin entwickeln, ohne Geld zu verlieren. Stockade gibt Ihnen 100.000 $ virtuelles Kapital und professionelle Tools — Candlestick-Charts, EMA/VWAP/RSI/MACD, ein vollständiges Orderbuch und ein detailliertes Analyse-Dashboard — dieselbe Umgebung wie bei einem echten Broker, komplett kostenlos und folgenlos.',
  },
];

const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://stockademarketsim.com/de/#faq',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(a) },
  })),
};

const faqSchemaJson = JSON.stringify(faqSchema).replace(/</g, '\\u003c');

const liveStatsLabels = {
  startingBalance: t(locale, 'home.stats.startingBalance'),
  tradableAssets: t(locale, 'home.stats.tradableAssets'),
  assetClasses: t(locale, 'home.stats.assetClasses'),
  costToStart: t(locale, 'home.stats.costToStart'),
};
---

<Layout
  title="Stockade | Kostenloser Börsensimulator"
  description="Ein kostenloser Börsensimulator mit virtuellem Geld. Üben Sie Day Trading und Paper Trading mit 100.000 $ — Aktien, Kryptowährungen, Forex, Futures."
  alternates={HOME_ALTERNATES}
>
  <Fragment slot="head">
    <!-- The WebSite and Organization entities live in SiteSchema.astro and are
         emitted on every page by the base layout — those stay shared across
         locales. This SoftwareApplication node's content (name/description/
         featureList) genuinely differs per locale, so — like the FAQPage node
         below — it gets its own page-specific @id/url rather than reusing the
         English page's. -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "SoftwareApplication",
            "@id": "https://stockademarketsim.com/de/#app",
            "name": "Stockade Börsensimulator",
            "url": "https://stockademarketsim.com/de/",
            "inLanguage": "de-DE",
            "applicationCategory": "FinanceApplication",
            "operatingSystem": "Web Browser",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD"
            },
            "description": "Kostenloser Online-Börsensimulator für Paper Trading mit Aktien, Kryptowährungen, Forex und Futures. Keine Anmeldung erforderlich.",
            "screenshot": "https://stockademarketsim.com/web-app-manifest-512x512.png",
            "featureList": [
              "Simulierte Candlestick-Charts mit Volumen",
              "EMA-, VWAP-, RSI-, MACD-Indikatoren",
              "Market- und Limit-Orders mit OCO-Stop-Loss-/Take-Profit-Brackets",
              "Paper Trading mit 100.000 $ virtuellem Guthaben",
              "Analyse-Dashboard mit Equity-Kurve",
              "Aktien, Kryptowährungen, Forex und Futures"
            ],
            "publisher": { "@id": "https://stockademarketsim.com/#organization" },
            "isPartOf": { "@id": "https://stockademarketsim.com/#website" }
          }
        ]
      }
    </script>
    {/* Generated from the `faqs` array above — see index.astro for why. */}
    <script type="application/ld+json" is:inline set:html={faqSchemaJson} />
  </Fragment>

  <Navbar alternates={HOME_ALTERNATES} />

  <!-- ── Hero ── -->
  <section class="relative overflow-hidden mesh-gradient">
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(var(--c-text) 1px, transparent 1px), linear-gradient(90deg, var(--c-text) 1px, transparent 1px); background-size: 40px 40px;"
    ></div>

    <div class="relative max-w-[1100px] mx-auto px-6 pt-24 pb-28 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--c-amber-bg)] border border-[var(--c-amber-dim)] text-[#f59e0b] text-[12px] font-mono mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-[#22c55e] animate-pulse"></span>
        Kostenlos · Keine Anmeldung · 100.000 $ virtuelles Guthaben
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] mb-6">
        Üben Sie den Markt.
        <br />
        <span class="gradient-text">Meistern Sie das Spiel.</span>
      </h1>

      <p class="text-lg sm:text-xl text-[var(--c-text-muted)] max-w-[600px] mx-auto mb-10 leading-relaxed">
        Der kostenlose Simulator für Aktien- und Krypto-Trading mit realistischen simulierten
        Marktdaten. Keine Anmeldung. Kein Risiko. Nur virtuelles Trading.
      </p>

      <div class="flex flex-wrap justify-center gap-3 mb-16">
        <a
          href="/de/simulator/"
          class="px-6 py-3 rounded-full bg-[#f59e0b] text-[#0a0a0a] font-semibold text-[15px] hover:bg-[#fbbf24] transition-colors"
        >
          Kostenlos mit dem Trading beginnen →
        </a>
        <a
          href="/de/markets/"
          class="px-6 py-3 rounded-full bg-[var(--c-bg-muted)] text-[var(--c-text)] font-semibold text-[15px] border border-[var(--c-border)] hover:bg-[var(--c-surface-2)] transition-colors"
        >
          Märkte ansehen
        </a>
      </div>

      <LiveStats client:load labels={liveStatsLabels} />
    </div>
  </section>

  <!-- ── App preview ── -->
  <section class="border-y border-[var(--c-border)] bg-[var(--c-bg-soft)] px-6 py-16">
    <div class="max-w-[1100px] mx-auto">
      <div class="rounded-xl overflow-hidden border border-[var(--c-border)] shadow-2xl">
        <div class="flex items-center gap-2 px-4 py-3 bg-[var(--c-bg-muted)] border-b border-[var(--c-border)]">
          <span class="w-3 h-3 rounded-full bg-[#ef4444]"></span>
          <span class="w-3 h-3 rounded-full bg-[#f59e0b]"></span>
          <span class="w-3 h-3 rounded-full bg-[#22c55e]"></span>
          <span class="ml-3 text-[12px] font-mono text-[var(--c-text-subtle)]">stockademarketsim.com/simulator — APXL 1M</span>
          <span class="ml-auto text-[10px] font-mono text-[var(--c-text-subtle)] border border-[var(--c-border)] px-2 py-0.5 rounded tracking-wider">BEISPIELVORSCHAU</span>
        </div>
        <div class="bg-[var(--c-bg-subtle)] relative overflow-hidden" style="height: 320px;">
          <svg viewBox="0 0 1200 320" class="w-full h-full" preserveAspectRatio="none">
            <line x1="0" y1="64" x2="1200" y2="64" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="128" x2="1200" y2="128" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="192" x2="1200" y2="192" stroke="var(--c-border)" stroke-width="1"/>
            <line x1="0" y1="256" x2="1200" y2="256" stroke="var(--c-border)" stroke-width="1"/>
            <defs>
              <linearGradient id="g1" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#22c55e" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="#22c55e" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path d="M0,240 C80,220 160,200 240,195 S400,165 480,150 S640,125 720,118 S900,100 960,95 S1100,80 1200,70"
              stroke="#22c55e" stroke-width="2" fill="none" opacity="0.9"/>
            <path d="M0,240 C80,220 160,200 240,195 S400,165 480,150 S640,125 720,118 S900,100 960,95 S1100,80 1200,70 V320 H0 Z"
              fill="url(#g1)"/>
          </svg>

          <div class="absolute top-4 left-4 rounded-lg px-3 py-2 border border-[var(--c-border)] backdrop-blur-sm" style="background-color: var(--c-overlay);">
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] uppercase tracking-widest mb-0.5">APXL · 1M</div>
            <div class="text-[22px] font-mono font-semibold text-[var(--c-text)]">$187.42</div>
            <div class="text-[13px] font-mono text-[#22c55e]">+1.23 (+0.66%)</div>
          </div>

          <div class="absolute top-4 right-4 w-[160px] rounded-lg border border-[var(--c-border)] p-3" style="background-color: var(--c-overlay);">
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] uppercase tracking-widest mb-2">Order</div>
            <div class="flex gap-1 mb-2">
              <div class="flex-1 py-1.5 bg-[var(--c-green-bg)] border border-[var(--c-green-dim)] text-[#22c55e] text-[11px] font-mono text-center rounded">KAUFEN</div>
              <div class="flex-1 py-1.5 bg-[var(--c-bg-muted)] border border-[var(--c-border)] text-[var(--c-text-subtle)] text-[11px] font-mono text-center rounded">VERKAUFEN</div>
            </div>
            <div class="text-[10px] font-mono text-[var(--c-text-subtle)] mb-1">Eigenkapital</div>
            <div class="text-[14px] font-mono font-semibold text-[#22c55e]">$102,340</div>
          </div>

          <div class="absolute bottom-4 left-4 flex gap-2">
            <div class="bg-[var(--c-green-bg)] border border-[var(--c-green-dim)] rounded px-2.5 py-1.5">
              <div class="text-[10px] font-mono text-[var(--c-text-subtle)]">P&amp;L</div>
              <div class="text-[15px] font-mono font-semibold text-[#22c55e]">+$2,340</div>
            </div>
            <div class="bg-[var(--c-amber-bg)] border border-[var(--c-amber-dim)] rounded px-2.5 py-1.5">
              <div class="text-[10px] font-mono text-[var(--c-text-subtle)]">Trefferquote</div>
              <div class="text-[15px] font-mono font-semibold text-[#f59e0b]">68%</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features ── -->
  <section class="py-24 px-6 bg-[var(--c-bg)]">
    <div class="max-w-[1100px] mx-auto">
      <div class="text-center mb-14">
        <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-3">Warum Stockade</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)]">Alles, was ein ernsthafter Trader braucht.</h2>
        <p class="mt-4 text-[var(--c-text-muted)] text-lg max-w-[480px] mx-auto">
          Gebaut zum Lernen, nicht zum Spielen. Professionelle Tools ohne den dazugehörigen Preis.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: '📈', title: 'Echte Candlestick-Charts',     desc: 'Vollständige Candlesticks mit Volumen, überlagert mit EMA-, VWAP-, RSI- und MACD-Indikatoren — dieselben Tools wie bei den Profis.' },
          { icon: '⚡', title: 'Sofortige Ausführung',          desc: 'Market-, Limit-, Stop-Loss-, Take-Profit- und OCO-Bracket-Orders werden sofort ausgeführt.' },
          { icon: '⌨️', title: 'Tastenkürzel',                  desc: 'B zum Kaufen, S zum Verkaufen, F zum Glattstellen. Traden Sie in Gedankengeschwindigkeit, ohne die Maus zu berühren.' },
          { icon: '📊', title: 'Analyse-Dashboard',             desc: 'Trefferquote, Profitfaktor, durchschnittlicher Gewinn/Verlust, Equity-Kurve, Drawdown und Heatmaps nach Tageszeit.' },
          { icon: '💼', title: 'Multi-Asset',                   desc: 'Aktien, Kryptowährungen, Forex-Paare und Futures — alles in einem Simulator.' },
          { icon: '📱', title: 'Mobile-first gedacht',          desc: 'Vollständig responsiv. Traden Sie vom Smartphone, Tablet oder Computer mit denselben Funktionen.' },
          { icon: '🆓', title: '100 % kostenlos, für immer',    desc: 'Alle Funktionen. Alle Assets. Keine Anmeldung. Keine Testphase. Kein Abonnement. Einfach loslegen.' },
        ].map(f => (
          <div class="bg-[var(--c-bg-soft)] border border-[var(--c-border)] rounded-xl p-5 hover:border-[var(--c-border-strong)] transition-colors group">
            <div class="text-2xl mb-3">{f.icon}</div>
            <h3 class="text-[15px] font-semibold text-[var(--c-text)] mb-2 group-hover:text-[#f59e0b] transition-colors">{f.title}</h3>
            <p class="text-[13px] text-[var(--c-text-subtle)] leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Asset coverage ── -->
  <section class="py-20 px-6 bg-[var(--c-bg-soft)] border-y border-[var(--c-border)]">
    <div class="max-w-[1100px] mx-auto">
      <div class="text-center mb-12">
        <div class="text-[11px] font-mono uppercase tracking-widest text-[#22c55e] mb-3">Abgedeckte Assets</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)]">Traden Sie alles.</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {[
          { label: 'Aktien',          sub: 'Aktien · 14 Ticker',                icon: '📈', color: '#3b82f6' },
          { label: 'Kryptowährungen', sub: 'Tokens & Coins · 8 Assets',         icon: '🪙', color: '#f59e0b' },
          { label: 'Forex',           sub: 'EUR/USD · GBP/USD · USD/JPY',       icon: '💱', color: '#22c55e' },
          { label: 'Futures',         sub: 'NQ · ES · CL · GC',                 icon: '🔮', color: '#8b5cf6' },
        ].map(a => (
          <div class="bg-[var(--c-bg)] border border-[var(--c-border)] rounded-xl p-5 text-center hover:border-[var(--c-border-strong)] transition-colors">
            <div class="text-3xl mb-3">{a.icon}</div>
            <div class="text-[16px] font-semibold mb-1" style={`color: ${a.color}`}>{a.label}</div>
            <div class="text-[12px] font-mono text-[var(--c-text-subtle)]" set:html={a.sub}></div>
          </div>
        ))}
      </div>
      <p class="text-center text-[11px] font-mono text-[var(--c-text-subtle)] mt-6">
        Alle Ticker sind fiktive simulierte Assets und stellen keine echten Wertpapiere, Kryptowährungen oder handelbaren Instrumente dar.
      </p>
    </div>
  </section>

  <!-- ── SEO Content ── -->
  <section class="py-24 px-6 bg-[var(--c-bg-soft)] border-t border-[var(--c-border)]">
    <div class="max-w-[800px] mx-auto">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-4">Über Stockade</div>
      <article class="prose-stockade">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--c-text)] mb-6">
          Üben Sie den Markt, ohne Geld zu riskieren
        </h2>

        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
Stockade ist ein <a href="/de/simulator/" class="text-[#f59e0b] hover:underline">Börsensimulator</a>, den Sie in einem Browser-Tab öffnen und etwa zehn Sekunden später schon nutzen. Sie erhalten <strong class="text-[var(--c-text)]">100.000 $ virtuelles Geld</strong> und eine vollständige Trading-Umgebung für Aktien, Kryptowährungen, Forex und Futures. Kein Konto anzulegen, keine Karte anzugeben, nichts zu installieren. Machen Sie einen katastrophalen Trade, und das Einzige, was Sie verlieren, ist eine Zahl auf einem Bildschirm — genau dafür ist Trading-Übung da.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Warum die meisten Trading-Spiele enttäuschen
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Viele Simulatoren sind auf Engagement statt auf Realismus optimiert. Sie verzichten auf Indikatoren, Ordertypen und Risikokennzahlen, sodass übrig bleibt, wie man einer steigenden Zahl zusieht — für einen Nachmittag unterhaltsam, aber es lehrt kaum etwas, das den Kontakt mit einem echten Broker übersteht. Wir haben uns für das Gegenteil entschieden. Stockade bietet Ihnen Candlestick-Charts mit Volumen-Histogrammen, EMA-9/20/50-Overlays, VWAP, RSI und MACD sowie ein Orderbuch mit Market- und Limit-Einträgen und Stop-Loss-/Take-Profit-Ständen, die wie eine OCO-Bracket-Order funktionieren. Der Gedanke: Die Gewohnheiten, die Sie hier entwickeln, sollen auch auf einer echten Plattform Bestand haben — siehe <a href="/blog/paper-trading-guide/" class="text-[#f59e0b] hover:underline">den Paper-Trading-Leitfaden</a>, um diesen Übergang reibungslos zu gestalten.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Zwei Übungswege: Live und Wiedergabe
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Der Live-Modus streamt sechs Assets gleichzeitig mit Kursupdates alle 800 Millisekunden, sodass Sie Day Trading gegen einen schnellen Feed üben und herausfinden können, wie Sie tatsächlich unter Druck reagieren. Der Wiedergabemodus macht das Gegenteil — Sie durchlaufen eine komplette Sitzung Kerze für Kerze, in Ihrem eigenen Tempo bei jeder Entscheidung. Die meisten nutzen den Live-Modus, um Reflexe aufzubauen, und den Wiedergabemodus, um Mustererkennung zu entwickeln — für ein Training, das sich ausschließlich auf das Lesen von Formationen statt auf den P&amp;L konzentriert, durchläuft der <a href="/de/chart-simulator/" class="text-[#f59e0b] hover:underline">Chart-Simulator</a> auf dieselbe Weise Candlestick-Muster. Von Brokern betriebene Paper-Trading-Simulatoren verlangen in der Regel eine Anmeldung und ein verknüpftes echtes Konto, bevor Sie auch nur eine Order platzieren können. Hier reicht es, die Seite zu öffnen.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Aktien, Kryptowährungen, Forex und Futures an einem Ort
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Es gibt 14 Aktien mit realistischem Kursverhalten, 8 Kryptowährungen, die sich mit der Volatilität bewegen, die man von echten digitalen Währungen erwarten würde, wichtige und weniger geläufige Devisenpaare sowie vier Futures — NQ, ES, CL und GC. Diese Vielfalt zählt mehr, als es scheint: Eine Strategie, die bei einer wenig volatilen Aktie brillant wirkt, bricht bei einem Devisenpaar oder Future oft zusammen, und all das auf <a href="/de/markets/" class="text-[#f59e0b] hover:underline">einer einzigen Plattform</a> zu vereinen, macht das leicht sichtbar.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Analysieren Sie, was wirklich passiert ist
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-6">
          Orders zu platzieren ist der einfache Teil; der nützliche Teil besteht darin, die Ergebnisse danach zu sezieren. Das <a href="/de/analytics/" class="text-[#f59e0b] hover:underline">Analyse-Dashboard</a> liest Ihren Trade-Verlauf aus und zeigt Equity-Kurve, Trefferquote, Profitfaktor, durchschnittlichen Gewinn und Verlust, maximalen Drawdown sowie eine Heatmap, die zeigt, zu welchen Tageszeiten Ihre Trades tatsächlich funktioniert haben. Da nichts zu installieren ist und keine Anmeldehürde besteht, läuft dieser gesamte Zyklus in einem Browser-Tab ab — was ihn auch für Klassenzimmer oder Lerngruppen nutzbar macht, wo es meist der schwierigste Teil ist, alle durch ein Anmeldeformular zu bekommen.
        </p>

        <h3 class="text-xl font-bold text-[var(--c-text)] mb-3 mt-8">
          Keine Paywall, kein Premium-Angebot
        </h3>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed mb-4">
          Viele Plattformen halten ihre besten Tools hinter einem Abonnement zurück oder verlangen eine E-Mail-Adresse, bevor Sie überhaupt einen Trade platzieren können. Bei Stockade ist das nicht der Fall. Hier ist alles dauerhaft enthalten:
        </p>
        <ul class="space-y-2 mb-6 ml-4">
          {[
            'Vollständige Candlestick-Charts mit Volumen',
            'Professionelle Indikatoren: EMA, VWAP, RSI, MACD',
            'Orderbuch: Market- und Limit-Einträge, OCO-Stop-Loss-/Take-Profit-Brackets',
            'Performance-Analyse mit Equity-Kurven und Drawdown-Tracking',
            'Vollständige Mobil- und Tablet-Kompatibilität',
          ].map(item => (
            <li class="flex items-start gap-2 text-[15px] text-[var(--c-text-muted)]">
              <span class="text-[#22c55e] mt-0.5 shrink-0">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-[var(--c-text-muted)] text-[16px] leading-relaxed">
          Keine Testphase, kein Freemium-Angebot, kein Upselling, keine E-Mail-Sammlung. Öffnen Sie den Simulator und fangen Sie an zu traden.
        </p>
      </article>
