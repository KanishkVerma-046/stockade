---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { CONTACT_ALTERNATES } from '../../i18n/alternates';
---

<Layout
  title="Kontakt | Stockade"
  description="Teilen Sie Ihr Feedback zu Stockade, unserem kostenlosen Börsensimulator. Melden Sie Bugs, Ideen oder sonstige Anmerkungen — in wenigen Sekunden."
  alternates={CONTACT_ALTERNATES}
>
  <Navbar alternates={CONTACT_ALTERNATES} />

  <main class="max-w-[680px] mx-auto px-6 py-16">

    <div class="mb-10">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-3">Kontakt</div>
      <h1 class="text-4xl font-bold tracking-tight text-[var(--c-text)] mb-3">Sagen Sie uns Ihre Meinung</h1>
      <p class="text-[16px] text-[var(--c-text-muted)] leading-relaxed">
        Bewerten Sie Ihre Erfahrung und hinterlassen Sie uns unten Kommentare, Bug-Berichte oder
        Ideen — wir lesen jede Nachricht.
      </p>
    </div>

    <!-- Google Form embed -->
    <div class="bg-[var(--c-bg-soft)] border border-[var(--c-border)] rounded-xl p-2 sm:p-3 mb-12">
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSfA5TEf_AHaCuygyjHEOOZm3LFKrziqaoKJCn1s8CAvbsVXWQ/viewform?embedded=true"
        title="Stockade Feedback-Formular"
        width="100%"
        height="700"
        style="border: 0; border-radius: 0.5rem;"
        loading="lazy"
      >Wird geladen…</iframe>
    </div>

    <!-- FAQ nudge -->
    <div class="mt-8 bg-[var(--c-bg-soft)] border border-[var(--c-border)] rounded-xl p-5">
      <p class="text-[13px] text-[var(--c-text-subtle)] leading-relaxed">
        Auf der Suche nach einer schnellen Antwort? Schauen Sie sich den <a href="/de/#faq" class="text-[#f59e0b] hover:text-[#fbbf24] underline underline-offset-2">FAQ</a>-Bereich
        der Startseite an — er deckt die häufigsten Fragen zur Funktionsweise des Simulators ab.
      </p>
    </div>

  </main>

  <Footer />
</Layout>
