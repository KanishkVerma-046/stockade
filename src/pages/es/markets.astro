---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import MarketsView from '../../components/markets/MarketsView.tsx';
import { MARKETS_ALTERNATES, localizedHref } from '../../i18n/alternates';
import { t } from '../../i18n/ui';

const locale = 'es' as const;
const marketsLabels = {
  trade: t(locale, 'markets.trade'),
  volumeAll: t(locale, 'markets.volume.all'),
  volumeShares: t(locale, 'markets.volume.shares'),
  volumeUsd: t(locale, 'markets.volume.usd'),
  volumeContracts: t(locale, 'markets.volume.contracts'),
  search: t(locale, 'markets.search'),
  categories: {
    all: t(locale, 'markets.category.all'),
    stock: t(locale, 'markets.category.stock'),
    crypto: t(locale, 'markets.category.crypto'),
    forex: t(locale, 'markets.category.forex'),
    futures: t(locale, 'markets.category.futures'),
  },
  colSymbol: t(locale, 'markets.col.symbol'),
  colName: t(locale, 'markets.col.name'),
  colPrice: t(locale, 'markets.col.price'),
  colChange: t(locale, 'markets.col.change'),
  colVolume: t(locale, 'markets.col.volume'),
  colMktCap: t(locale, 'markets.col.mktCap'),
  colAction: t(locale, 'markets.col.action'),
  assetNames: {
    'EUR/USD': t(locale, 'markets.asset.EURUSD'),
    'GBP/USD': t(locale, 'markets.asset.GBPUSD'),
    'USD/JPY': t(locale, 'markets.asset.USDJPY'),
    '/ES': t(locale, 'markets.asset.ES'),
    '/NQ': t(locale, 'markets.asset.NQ'),
    '/CL': t(locale, 'markets.asset.CL'),
    '/GC': t(locale, 'markets.asset.GC'),
  },
};
---

<Layout
  title="Mercados de Acciones, Cripto, Forex y Futuros | Stockade"
  description="Monitorea 29 activos simulados: acciones, cripto, forex y futuros, en nuestro simulador de mercado de valores gratuito en línea. Sin registro."
  alternates={MARKETS_ALTERNATES}
>
  <Navbar alternates={MARKETS_ALTERNATES} />
  <main class="max-w-[1400px] mx-auto px-4 py-8">
    <div class="mb-8">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-2">Mercados</div>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--c-text)]">Resumen del Mercado</h1>
      <p class="mt-2 text-[var(--c-text-subtle)] text-[14px]">El resumen del mercado se actualiza cada 2 segundos en 29 activos simulados — acciones, cripto, forex y futuros. Úsalo como watchlist de un simulador de trading de cripto, como scanner de un simulador de forex, o simplemente para revisar rápido dónde están los precios antes de operar. Ordena por cambio de precio para ver qué activos se mueven más, y revisa la columna de volumen junto a eso — consulta <a href="/es/blog/entendiendo-el-volumen-de-trading/" class="text-[#f59e0b] hover:underline">entendiendo el volumen de trading</a> para saber qué te dice realmente ese número. Para ticks en vivo de 800ms, usa el <a href="/es/simulator/" class="text-[#f59e0b] hover:underline">Simulador de Trading</a>.</p>
    </div>
    <MarketsView
      client:load
      simulatorHref={localizedHref('/simulator/', locale)}
      labels={marketsLabels}
    />

    <section class="mt-16 pt-12 border-t border-[var(--c-border)] max-w-[820px]">
      <h2 class="text-xl font-bold tracking-tight text-[var(--c-text)] mb-4">
        Cómo usar el Resumen del Mercado
      </h2>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        La tabla cubre los 29 activos simulados que ofrece Stockade — 14 acciones, 8 pares de cripto, 3 pares de forex y 4 contratos de futuros — con precios que se actualizan cada 2 segundos, para que veas cómo se mueve cada clase de activo sin abrir una operación.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">Filtrar y ordenar</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        Usa las pestañas de categoría para limitar la tabla a una clase de activo, o el cuadro de búsqueda para ir directo a un símbolo o nombre. Haz clic en los encabezados de columna Símbolo, Precio o Cambio para ordenar por ese campo — haz clic de nuevo para invertir el orden. La vista predeterminada ordena por Cambio, así que los activos que más se mueven aparecen primero.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">Leer las columnas</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        Precio y Cambio se explican solos, pero Volumen usa una unidad distinta según la clase de activo — acciones negociadas en acciones, volumen nocional en dólares en cripto y forex, y contratos en futuros — porque esa es la convención que realmente usa cada mercado. Cap. de mercado solo aplica a acciones y cripto; los pares de forex y los contratos de futuros muestran <span class="font-mono">—</span> porque el concepto no se traslada a ninguno de los dos.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">Operar desde la tabla</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        El botón Operar de cada fila abre el <a href={localizedHref('/simulator/', locale)} class="text-[#f59e0b] hover:underline">Simulador de Trading</a> con ese símbolo ya seleccionado, para que pases de detectar un movimiento aquí a colocar una orden sin volver a buscarlo. Si prefieres ver la acción del precio desarrollarse vela por vela antes de comprometerte con una lectura, el <a href={localizedHref('/chart-simulator/', locale)} class="text-[#f59e0b] hover:underline">Simulador de Gráficos</a> reproduce las mismas clases de activo barra por barra.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
