---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blogEs', ({ data }) => !data.draft);
  const enPosts = await getCollection('blog', ({ data }) => !data.draft);
  const enIds = new Set(enPosts.map(p => p.id));
  // A Spanish post's `translationOf` names the id of the English post it
  // translates — its own id/slug is independently localized, so the two are
  // matched via this field rather than by sharing a filename.
  return posts.map(post => ({
    params: { slug: post.id },
    props: {
      post,
      alternates: enIds.has(post.data.translationOf)
        ? { en: `/blog/${post.data.translationOf}/`, es: `/es/blog/${post.id}/` }
        : undefined,
    },
  }));
}

const { post, alternates } = Astro.props;
const posts = await getCollection('blogEs', ({ data }) => !data.draft);
const { Content, headings } = await render(post);
---

<BlogPost post={post} posts={posts} headings={headings} alternates={alternates}>
  <Content />
</BlogPost>
