---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import MarketsView from '../../components/markets/MarketsView.tsx';
import { MARKETS_ALTERNATES, localizedHref } from '../../i18n/alternates';
import { t } from '../../i18n/ui';

const locale = 'pt' as const;
const marketsLabels = {
  trade: t(locale, 'markets.trade'),
  volumeAll: t(locale, 'markets.volume.all'),
  volumeShares: t(locale, 'markets.volume.shares'),
  volumeUsd: t(locale, 'markets.volume.usd'),
  volumeContracts: t(locale, 'markets.volume.contracts'),
  search: t(locale, 'markets.search'),
  categories: {
    all: t(locale, 'markets.category.all'),
    stock: t(locale, 'markets.category.stock'),
    crypto: t(locale, 'markets.category.crypto'),
    forex: t(locale, 'markets.category.forex'),
    futures: t(locale, 'markets.category.futures'),
  },
  colSymbol: t(locale, 'markets.col.symbol'),
  colName: t(locale, 'markets.col.name'),
  colPrice: t(locale, 'markets.col.price'),
  colChange: t(locale, 'markets.col.change'),
  colVolume: t(locale, 'markets.col.volume'),
  colMktCap: t(locale, 'markets.col.mktCap'),
  colAction: t(locale, 'markets.col.action'),
  assetNames: {
    'EUR/USD': t(locale, 'markets.asset.EURUSD'),
    'GBP/USD': t(locale, 'markets.asset.GBPUSD'),
    'USD/JPY': t(locale, 'markets.asset.USDJPY'),
    '/ES': t(locale, 'markets.asset.ES'),
    '/NQ': t(locale, 'markets.asset.NQ'),
    '/CL': t(locale, 'markets.asset.CL'),
    '/GC': t(locale, 'markets.asset.GC'),
  },
};
---

<Layout
  title="Mercados de Ações, Cripto, Forex e Futuros | Stockade"
  description="Monitore 29 ativos simulados: ações, cripto, forex e futuros, no nosso simulador gratuito de mercado de ações online. Sem cadastro."
  alternates={MARKETS_ALTERNATES}
>
  <Navbar alternates={MARKETS_ALTERNATES} />
  <main class="max-w-[1400px] mx-auto px-4 py-8">
    <div class="mb-8">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#f59e0b] mb-2">Mercados</div>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--c-text)]">Visão Geral do Mercado</h1>
      <p class="mt-2 text-[var(--c-text-subtle)] text-[14px]">A visão geral do mercado é atualizada a cada 2 segundos em 29 ativos simulados — ações, cripto, forex e futuros. Use-a como watchlist de um simulador de trading de cripto, como scanner de um simulador de forex, ou apenas para checar rapidamente onde os preços estão antes de operar. Ordene por variação de preço para ver quais ativos estão se movendo mais, e confira a coluna de volume ao lado — veja <a href="/pt/blog/entendendo-o-volume-de-trading/" class="text-[#f59e0b] hover:underline">entendendo o volume de trading</a> para saber o que esse número realmente indica. Para ticks ao vivo de 800ms, use o <a href="/pt/simulator/" class="text-[#f59e0b] hover:underline">Simulador de Trading</a>.</p>
    </div>
    <MarketsView
      client:load
      simulatorHref={localizedHref('/simulator/', locale)}
      labels={marketsLabels}
    />

    <section class="mt-16 pt-12 border-t border-[var(--c-border)] max-w-[820px]">
      <h2 class="text-xl font-bold tracking-tight text-[var(--c-text)] mb-4">
        Como usar a Visão Geral do Mercado
      </h2>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        A tabela cobre os 29 ativos simulados que o Stockade oferece — 14 ações, 8 tokens cripto, 3 pares de moedas e 4 símbolos de futuros — com preços que se atualizam a cada 2 segundos, para que você veja como cada classe de ativo se move sem abrir uma operação.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">Filtrar e ordenar</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        Use as abas de categoria para limitar a tabela a uma classe de ativo, ou a caixa de busca para ir direto a um símbolo ou nome. Clique nos cabeçalhos das colunas Símbolo, Preço ou Variação para ordenar por esse campo — clique de novo para inverter a ordem. A visualização padrão ordena por Variação, então os ativos que mais se movem aparecem primeiro.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">Ler as colunas</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        Preço e Variação dispensam explicação, mas Volume usa uma unidade diferente para cada classe de ativo — em ações, o número de ações negociadas; em cripto e forex, o valor negociado em dólares americanos; e em futuros, o número de contratos — porque essa é a convenção que cada mercado realmente usa. Cap. de mercado só se aplica a ações e cripto; pares de moedas e futuros mostram <span class="font-mono">—</span> porque o conceito não se aplica a nenhum dos dois.
      </p>

      <h3 class="text-[15px] font-semibold text-[var(--c-text)] mt-8 mb-3">Operar a partir da tabela</h3>
      <p class="text-[15px] text-[var(--c-text-muted)] leading-relaxed">
        O botão Operar de cada linha abre o <a href={localizedHref('/simulator/', locale)} class="text-[#f59e0b] hover:underline">Simulador de Trading</a> com esse símbolo já selecionado, para que você passe de identificar um movimento aqui a colocar uma ordem sem precisar buscá-lo de novo. Se preferir ver a ação de preço se desenrolar vela por vela antes de se comprometer com uma leitura, o <a href={localizedHref('/chart-simulator/', locale)} class="text-[#f59e0b] hover:underline">Simulador de Gráficos</a> reproduz as mesmas classes de ativo barra por barra.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
