---
import { t } from '../../i18n/ui';
import { getLocaleMeta } from '../../i18n/locales';

const year = new Date().getFullYear();
const locale = getLocaleMeta(Astro.currentLocale).code;
---

<footer class="border-t border-[#2a2a2a] bg-[#0a0a0a] mt-auto">
  <div class="max-w-[1400px] mx-auto px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 mb-12">
      <!-- Brand -->
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-7 h-7 rounded-md bg-[#f59e0b] flex items-center justify-center">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M2 12L6 7L10 9L14 3" stroke="#0a0a0a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="text-[15px] font-semibold text-[#f5f5f5]">Stockade</span>
        </a>
        <p class="text-[13px] text-[#666666] leading-relaxed max-w-[220px]">
          {t(locale, 'footer.tagline')}
        </p>
        <p class="mt-4 text-[11px] font-mono text-[#f59e0b]">stockademarketsim.com</p>
      </div>

      <!-- Product -->
      <div>
        <p class="text-[11px] font-mono uppercase tracking-widest text-[#666666] mb-3">{t(locale, 'footer.product')}</p>
        <ul class="space-y-2">
          {[
            { href: '/simulator',       label: 'Trading Simulator' },
            { href: '/chart-simulator', label: 'Chart Simulator'   },
            { href: '/markets',         label: 'Markets'           },
            { href: '/analytics',       label: 'Analytics'         },
            { href: '/blog',            label: 'Learn'             },
          ].map(l => (
            <li>
              <a href={l.href} class="text-[13px] text-[#a1a1a1] hover:text-[#f5f5f5] transition-colors">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <p class="text-[11px] font-mono uppercase tracking-widest text-[#666666] mb-3">{t(locale, 'footer.company')}</p>
        <ul class="space-y-2">
          {[
            { href: '/about',   label: 'About' },
            { href: '/contact', label: 'Contact' },
          ].map(l => (
            <li>
              <a href={l.href} class="text-[13px] text-[#a1a1a1] hover:text-[#f5f5f5] transition-colors">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class="text-[11px] font-mono uppercase tracking-widest text-[#666666] mb-3">{t(locale, 'footer.legal')}</p>
        <ul class="space-y-2">
          {[
            { href: '/privacy',    label: 'Privacy' },
            { href: '/terms',      label: 'Terms' },
            { href: '/disclaimer', label: 'Disclaimer' },
          ].map(l => (
            <li>
              <a href={l.href} class="text-[13px] text-[#a1a1a1] hover:text-[#f5f5f5] transition-colors">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t border-[#1a1a1a] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-[12px] text-[#666666]">
        © {year} Stockade. {t(locale, 'footer.rights')}
      </p>
      <p class="text-[11px] text-[#444444] leading-relaxed max-w-[480px]">
        {t(locale, 'footer.disclaimerText')}
      </p>
    </div>
  </div>
</footer>
