---
// Slim cookie consent bar, shown until the visitor accepts or rejects.
//
// Rendered hidden and revealed by script so it never flashes for visitors who
// already chose. Depends on window.stockadeConsent from ConsentScripts.astro,
// which must be in <head> on the same page.
//
// No geo gating: the site is a static Cloudflare Pages build, so there is no
// request-time header (CF-IPCountry etc.) available at render. Showing the
// banner to everyone is the safe, simpler option.
---

<div
  id="cookie-consent"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
  hidden
  class="fixed bottom-0 inset-x-0 z-[9999] border-t border-[var(--c-border)] bg-[var(--c-bg-soft)] px-4 py-3 sm:px-6"
>
  <div class="mx-auto flex max-w-[1400px] flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
    <p class="text-[13px] leading-relaxed text-[var(--c-text-muted)]">
      We use cookies to improve your experience and serve relevant ads. By using this site, you agree
      to our use of cookies. Read our
      <a
        href="/privacy/"
        class="text-[#f59e0b] underline underline-offset-2 hover:text-[#fbbf24] transition-colors"
        >Privacy Policy</a
      >.
    </p>

    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        data-consent="reject"
        class="rounded-md border border-[var(--c-border)] bg-transparent px-3 py-1.5 text-[12px] font-medium text-[var(--c-text-muted)] transition-colors hover:border-[var(--c-border-strong)] hover:text-[var(--c-text)]"
      >
        Reject non-essential
      </button>
      <button
        type="button"
        data-consent="accept"
        class="rounded-md bg-[#f59e0b] px-4 py-1.5 text-[12px] font-semibold text-[#0a0a0a] transition-colors hover:bg-[#fbbf24]"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('cookie-consent');
    if (!el) return;

    var consent = window.stockadeConsent;
    // Without the head loader there is nothing to gate, so showing a banner
    // whose buttons do nothing would be worse than showing none.
    if (!consent) return;

    if (consent.get() === 'accepted' || consent.get() === 'rejected') return;
    el.hidden = false;

    el.addEventListener('click', function (event) {
      var button = event.target.closest('[data-consent]');
      if (!button) return;

      if (button.dataset.consent === 'accept') {
        consent.accept();
      } else {
        consent.reject();
      }
      el.hidden = true;
    });
  })();
</script>
